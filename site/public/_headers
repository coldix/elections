# Cloudflare Workers static assets headers.
# https://developers.cloudflare.com/workers/static-assets/headers/
# Improves crawl efficiency (cacheable assets) and basic security without
# blocking indexing or AI citation.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: interest-cohort=()

# Fingerprinted Astro build assets — long cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand / icons
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Machine-readable exports — short cache so updates appear quickly
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *

# AI / crawler guides — revalidate often after deploys
/llms.txt
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
/robots.txt
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
/sitemap-index.xml
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
/sitemap-0.xml
  Cache-Control: public, max-age=600, stale-while-revalidate=3600
