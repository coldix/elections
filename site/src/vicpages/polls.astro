---
import Base from "../layouts/Base.astro";
import PollCharts from "../components/PollCharts.astro";
import { SITE, VIC2026, formatDate } from "../lib/site.mjs";
import { listElections } from "../../../scripts/lib/data.mjs";
import {
  loadPolls,
  computePollAverage,
  PARTY_LABELS,
  POLL_CAVEAT,
} from "../../../scripts/lib/polls.mjs";

const electionId = listElections()[0] ?? "vic2026";
const polls = loadPolls(electionId);
const average = computePollAverage(polls);
const included = new Set(average.included_poll_ids ?? []);
const partyOrder = ["alp", "lnp", "onp", "grn", "others"];

const sortedPolls = [...polls].sort((a, b) =>
  a.fieldwork_end < b.fieldwork_end ? 1 : -1
);

const avgLine =
  average.status === "ok" && average.primaries
    ? `Latest tracker average (as of ${average.as_of}): Labor ${average.primaries.alp}%, ` +
      `Coalition ${average.primaries.lnp}%, One Nation ${average.primaries.onp}%, ` +
      `Greens ${average.primaries.grn}%, Others ${average.primaries.others}%. Not a forecast.`
    : "Sourced Victorian statewide primary-vote poll ledger with transparent average rules.";

const schema = [
  {
    "@type": "Dataset",
    name: "Victorian state election 2026 — statewide poll ledger and average",
    description:
      "Public statewide Legislative Assembly voting-intention polls for Victoria 2026, " +
      "each with sources, plus a weighted primary-vote average with uncertainty bands. Not a forecast.",
    url: `${SITE.url}${VIC2026}/polls`,
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    creator: { "@id": `${SITE.url}/#organization` },
    temporalCoverage: "2026",
    spatialCoverage: { "@type": "Place", name: "Victoria, Australia" },
    variableMeasured: [
      "Primary vote ALP",
      "Primary vote L-NP",
      "Primary vote One Nation",
      "Primary vote Greens",
      "Primary vote Others",
    ],
    distribution: [
      {
        "@type": "DataDownload",
        encodingFormat: "application/json",
        contentUrl: `${SITE.url}/data/${electionId}/polls.json`,
      },
      {
        "@type": "DataDownload",
        encodingFormat: "application/json",
        contentUrl: `${SITE.url}/data/${electionId}/poll-average.json`,
      },
      {
        "@type": "DataDownload",
        encodingFormat: "text/csv",
        contentUrl: `${SITE.url}/data/${electionId}/polls.csv`,
      },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Is the poll average a forecast of the Victorian election?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "No. It is a transparent weighted summary of recent public statewide primary-vote " +
            "polls that meet published inclusion rules. It does not model seats, preferences or election day.",
        },
      },
      {
        "@type": "Question",
        name: "Where are the machine-readable poll figures?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            `JSON and CSV exports: ${SITE.url}/data/${electionId}/polls.json and ` +
            `${SITE.url}/data/${electionId}/poll-average.json. Methodology: ` +
            "https://github.com/coldix/elections/blob/main/docs/POLL-METHODOLOGY.md",
        },
      },
      {
        "@type": "Question",
        name: "Which polls enter the average?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "Eligible public statewide Victorian Assembly polls with published fieldwork, sample size, " +
            "mode and primaries. Party/union/advocacy polls are excluded by default. " +
            "Rules are in POLL-METHODOLOGY.md in the public repository.",
        },
      },
    ],
  },
];
---

<Base
  title="Victorian election polls 2026 — average and ledger"
  description={`Victorian state election 2026 polls: sourced statewide primary votes and a transparent weighted average with uncertainty bands. ${avgLine}`}
  schema={schema}
  breadcrumbs={[
    { name: "Victoria 2026", href: VIC2026 },
    { name: "Poll average", href: `${VIC2026}/polls` },
  ]}
>
  <div class="wrap wrap-polls section">
    <p class="eyebrow">Victorian state election 2026 · statewide voting intention</p>
    <h1>Victorian election poll average</h1>
    <p class="lede">
      Public statewide primary-vote polls for the <strong>Victorian Legislative Assembly</strong>, each with a
      dated source, plus a transparent weighted average under published rules. This is a
      summary of recent polling — <strong>not a forecast</strong> of election day.
    </p>

    <div class="notice" role="note">
      <strong>Read the bands carefully.</strong> {POLL_CAVEAT}
    </div>

    {
      average.status === "ok" && average.primaries ? (
        <section aria-labelledby="avg-heading">
          <h2 id="avg-heading">Tracker average</h2>
          <p class="muted">
            As of fieldwork ending {formatDate(average.as_of)} · {average.included_poll_ids.length}{" "}
            polls · {average.window_days_used}-day window · half-life {average.parameters.half_life_days}{" "}
            days · default design effect {average.parameters.design_effect_default}
          </p>
          <div class="table-scroll">
            <table class="data">
              <caption class="visually-hidden">Weighted primary-vote average with 95% intervals</caption>
              <thead>
                <tr>
                  <th scope="col">Party</th>
                  <th scope="col" class="num">Average</th>
                  <th scope="col" class="num">95% band</th>
                </tr>
              </thead>
              <tbody>
                {partyOrder.map((k) => (
                  <tr>
                    <th scope="row">{PARTY_LABELS[k]}</th>
                    <td class="num mono">{average.primaries[k].toFixed(1)}%</td>
                    <td class="num mono muted">
                      {average.intervals[k].low.toFixed(1)}–{average.intervals[k].high.toFixed(1)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="muted">
            Weights combine effective sample size and exponential time decay. Full formula:
            <a href="https://github.com/coldix/elections/blob/main/docs/POLL-METHODOLOGY.md">
              poll methodology
            </a>
            · machine-readable
            <a href={`/data/${electionId}/poll-average.json`}>poll-average.json</a>.
          </p>
          {
            average.bloc_split && (
              <PollCharts primaries={average.primaries} blocs={average.bloc_split} />
            )
          }
        </section>
      ) : (
        <section aria-labelledby="avg-heading">
          <h2 id="avg-heading">Tracker average</h2>
          <p>
            No numeric average is published right now
            {average.note ? ` — ${average.note}` : ""}. Eligible polls are still listed below.
          </p>
        </section>
      )
    }

    <h2 id="polls">Polls in the ledger</h2>
    <p>
      Every row is a sourced record in the repository. Polls marked
      <strong>Excluded</strong> fail inclusion rules and are kept for transparency.
      <strong>In*</strong> means the poll is in the average under a documented
      case-by-case exception (hover for the reason).
    </p>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Fieldwork</th>
            <th scope="col">Pollster</th>
            <th scope="col" class="num">n</th>
            <th scope="col" class="num">ALP</th>
            <th scope="col" class="num">L-NP</th>
            <th scope="col" class="num">ONP</th>
            <th scope="col" class="num">GRN</th>
            <th scope="col" class="num">OTH</th>
            <th scope="col">Average</th>
          </tr>
        </thead>
        <tbody>
          {
            sortedPolls.map((p) => (
              <tr>
                <th scope="row" class="mono">
                  {formatDate(p.fieldwork_end)}
                </th>
                <td>
                  {p.pollster}
                  <span class="muted block-sm">{p.commissioner_type}</span>
                </td>
                <td class="num mono">{p.sample_size}</td>
                <td class="num mono">{p.primaries.alp}</td>
                <td class="num mono">{p.primaries.lnp}</td>
                <td class="num mono">{p.primaries.onp}</td>
                <td class="num mono">{p.primaries.grn}</td>
                <td class="num mono">{p.primaries.others}</td>
                <td>
                  {included.has(p.id) ? (
                    <span
                      class="pill in"
                      title={p.eligibility_exception ?? undefined}
                    >
                      {p.eligibility_exception ? "In*" : "In"}
                    </span>
                  ) : p.eligible_for_average ? (
                    <span
                      class="pill out"
                      title={p.eligibility_exception ?? undefined}
                    >
                      {p.eligibility_exception ? "Window*" : "Window"}
                    </span>
                  ) : (
                    <span class="pill out" title={p.exclusion_reason ?? ""}>
                      Excluded
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="rules">Which polls count</h2>
    <ul>
      <li>Victorian <strong>state</strong> Assembly voting intention only (not federal).</li>
      <li>Published fieldwork dates and sample size (n ≥ 800).</li>
      <li>
        Commissioner is media, the pollster, or neutral academic by default — party,
        union or advocacy are out unless a documented case-by-case exception applies
        (<span class="mono">In*</span> in the table).
      </li>
      <li>
        Rolling window (45 days, extendable to 60), one poll per pollster, at least two
        pollsters before a number is published.
      </li>
    </ul>
    <p>
      Full rules and maths:
      <a href="https://github.com/coldix/elections/blob/main/docs/POLL-METHODOLOGY.md">
        docs/POLL-METHODOLOGY.md
      </a>
      · downloads:
      <a href={`/data/${electionId}/polls.json`}>polls.json</a>,
      <a href={`/data/${electionId}/polls.csv`}>polls.csv</a>,
      <a href={`/data/${electionId}/poll-average.json`}>poll-average.json</a>.
    </p>

    <p class="foot muted">
      Candidate coverage remains the core product of this site. Poll records use the same
      source discipline as candidacies. Ordering of parties elsewhere never uses these
      figures — see <a href="/methodology#ordering">methodology</a>.
    </p>
  </div>
</Base>

<style>
  .wrap-polls {
    max-width: 52rem;
  }
  h2 {
    margin-top: 2.5rem;
  }
  ul {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    color: var(--ink-2);
  }
  .notice {
    margin: 1.25rem 0;
  }
  .block-sm {
    display: block;
    font-size: 0.8rem;
  }
  .pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
  }
  .pill.in {
    background: var(--surface-2);
  }
  .pill.out {
    color: var(--ink-2);
  }
  .foot {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
</style>
