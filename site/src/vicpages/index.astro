---
import Base from "../layouts/Base.astro";
import Countdown from "../components/Countdown.astro";
import StatGrid from "../components/StatGrid.astro";
import YouTubeLite from "../components/YouTubeLite.astro";
import AdRow from "../components/AdRow.astro";
import { SITE, partyColour, formatDate } from "../lib/site.mjs";
import { VIDEOS } from "../lib/videos.mjs";
import {
  loadElection,
  coverageFor,
  summaryFor,
  COVERAGE_CAVEAT,
  LIVE_STATUSES,
} from "../../../scripts/lib/data.mjs";

const data = loadElection("vic2026");
const coverage = coverageFor(data);
const summary = summaryFor(data);

const stats = [
  { value: summary.districts, label: "Legislative Assembly districts" },
  {
    value: summary.regions,
    label: "Legislative Council regions",
    note: `${summary.council_members} sitting members`,
  },
  { value: summary.live_candidates, label: "Live candidacies", note: "sourced records" },
  { value: summary.retirements, label: "Confirmed retirements", note: "not recontesting" },
  {
    value: `${summary.districts_with_candidates}/${summary.districts}`,
    label: "Districts with ≥1 record",
  },
  { value: summary.sources, label: "Distinct sources cited" },
];

// Every party with seats held now and/or any sourced 2026 coverage.
// Order is seats held (both houses), then alphabetically — not a campaign ranking.
const coverageTeaser = coverage.filter(
  (c) =>
    c.current.total > 0 ||
    c.assembly_seats_covered > 0 ||
    c.council_seats_covered > 0
);

const retireByParty = data.parties
  .map((p) => ({
    ...p,
    count: data.retirements.filter((r) => r.party === p.slug).length,
  }))
  .filter((p) => p.count > 0)
  .sort((a, b) => b.count - a.count);

const openSeats = data.retirements.filter((r) => r.role === "MLA").length;

const emptyDistricts = data.districts
  .filter((d) => !d.candidates.some((c) => LIVE_STATUSES.includes(c.status)))
  .sort((a, b) => a.name.localeCompare(b.name));

const schema = {
  "@type": "Dataset",
  name: "Australian Election Tracker — Victorian state election 2026 candidate ledger",
  description:
    "Open, individually sourced records of announced, endorsed, formally nominated, " +
    "withdrawn and disendorsed candidates for the 2026 Victorian state election.",
  url: `${SITE.url}/elections/vic/2026`,
  license: "https://creativecommons.org/licenses/by/4.0/",
  isAccessibleForFree: true,
  creator: { "@id": `${SITE.url}/#organization` },
  temporalCoverage: `2024/${data.election.election_day}`,
  spatialCoverage: { "@type": "Place", name: "Victoria, Australia" },
  keywords: [
    "Victorian election 2026",
    "Victoria candidates",
    "Legislative Assembly",
    "Legislative Council",
    "open election data",
  ],
  distribution: [
    {
      "@type": "DataDownload",
      encodingFormat: "application/json",
      contentUrl: `${SITE.url}/data/vic2026/candidates.json`,
    },
    {
      "@type": "DataDownload",
      encodingFormat: "text/csv",
      contentUrl: `${SITE.url}/data/vic2026/candidates.csv`,
    },
    {
      "@type": "DataDownload",
      encodingFormat: "application/json",
      contentUrl: `${SITE.url}/data/vic2026/coverage.json`,
    },
  ],
};
---

<Base
  title="Victorian state election 2026 candidates — sourced tracker"
  description="Victorian election 2026 candidate tracker: independently sourced announced, endorsed and nominated candidacies across 88 Assembly districts and 8 Council regions. Open JSON/CSV — not the VEC, not a forecast."
  schema={schema}
  breadcrumbs={[{ name: "Victoria 2026", href: "/elections/vic/2026" }]}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Independent · Sourced · Machine-readable</p>
      <h1>Who is standing, where, and what proves it.</h1>
      <p class="lede">
        Australian Election Tracker is a public ledger of 2026 Victorian candidacies — each with
        a dated source — plus open JSON/CSV. Not a forecast. Not how-to-vote advice. Not the VEC.
      </p>
      <p class="hero-actions btn-row">
        <a class="btn" href="/assembly">Browse Assembly seats</a>
        <a class="btn btn-ghost" href="/voting">Voting guide</a>
        <a class="btn btn-ghost" href="/data">Open data</a>
      </p>

      <p class="notice prelaunch">
        <strong>Live since July 2026.</strong> Coverage is incomplete by design: we only count
        sourced records.{" "}
        <a href="/methodology#coverage">How we count</a>.
      </p>
    </div>
  </section>

  <div class="wrap home-body">
    <Countdown election={data.election} keyDates={data.election.dates} />

    <section class="section paths" aria-labelledby="paths-h">
      <h2 id="paths-h">Start here</h2>
      <div class="card-grid">
        <a class="card link-card" href="/assembly">
          <h3>Who is standing?</h3>
          <p>88 Assembly districts — sitting members and sourced 2026 candidates.</p>
        </a>
        <a class="card link-card" href="/voting">
          <h3>How do I vote?</h3>
          <p>Enrolment, compulsory voting, preferential numbering — civic guide + video.</p>
        </a>
        <a class="card link-card" href="/council">
          <h3>Upper house?</h3>
          <p>8 regions × 5 seats. Sitting MLCs and any sourced Council candidacies.</p>
        </a>
        <a class="card link-card" href="/polls">
          <h3>What are the polls saying?</h3>
          <p>Sourced statewide primaries and a transparent average — not a forecast.</p>
        </a>
        <a class="card link-card" href="/parties/issues">
          <h3>Who is responsible?</h3>
          <p>State vs federal vs local — jurisdiction guide for key election issues.</p>
        </a>
        <a class="card link-card" href="/parties/matrix">
          <h3>Compare party policies</h3>
          <p>Side-by-side sourced positions — no ratings, quotes and cost chips only.</p>
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="numbers-h">
      <h2 id="numbers-h">At a glance</h2>
      <StatGrid stats={stats} />
      <p class="muted after-stats">
        Generated at build time. Last source verification:{" "}
        <strong>{formatDate(summary.latest_verified)}</strong>.
        {emptyDistricts.length > 0 && (
          <>
            {" "}
            Districts with no sourced candidacy yet:{" "}
            {emptyDistricts.map((d, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/districts/${d.slug}`}>{d.name}</a>
              </>
            ))}
            .
          </>
        )}
      </p>
    </section>

    <section id="coverage" class="section" aria-labelledby="coverage-h">
      <h2 id="coverage-h">Coverage snapshot</h2>
      <div class="notice caveat" role="note">
        <strong>Two different numbers.</strong>{" "}
        <em>Seats held now</em> is today’s Parliament (Assembly + Council).{" "}
        <em>2026 covered</em> is only seats where we have a sourced candidacy for that
        party — Assembly (of 88) and Council (of 40) — not vote share, not a prediction.
        The progress bar is both houses combined (of 128).{" "}
        {COVERAGE_CAVEAT}{" "}
        <a href="/methodology#coverage">How we count</a>.
      </div>

      <div class="table-scroll">
        <table class="data teaser">
          <caption class="visually-hidden">
            Party seats held now versus sourced 2026 Assembly and Council coverage
          </caption>
          <thead>
            <tr>
              <th scope="col">Party</th>
              <th scope="col" class="num">Seats held now</th>
              <th scope="col" class="num">2026 Assembly</th>
              <th scope="col" class="num">2026 Council</th>
              <th scope="col" class="sub">Progress (of 128)</th>
            </tr>
          </thead>
          <tbody>
            {
              coverageTeaser.map((c) => (
                <tr>
                  <th scope="row">
                    <a href={`/parties/${c.party}`} class="party-cell">
                      <span
                        class="swatch"
                        style={`--party-colour:${partyColour(c.party)}`}
                        aria-hidden="true"
                      />
                      {c.short_name}
                    </a>
                  </th>
                  <td class="num mono held-now">
                    {c.current.total ? (
                      <>
                        <span class="held-total">{c.current.total}</span>
                        <span class="muted held-split">
                          {" "}
                          ({c.current.assembly}A · {c.current.council}C)
                        </span>
                      </>
                    ) : (
                      "—"
                    )}
                  </td>
                  <td class="num mono">
                    {c.assembly_seats_covered}
                    <span class="muted"> / {c.assembly_seats_total}</span>
                  </td>
                  <td class="num mono">
                    {c.council_seats_covered}
                    <span class="muted"> / {c.council_seats_total}</span>
                  </td>
                  <td>
                    <span class="bar" aria-hidden="true">
                      <span
                        class="bar-fill"
                        style={`width:${c.combined_pct}%;--party-colour:${partyColour(c.party)}`}
                      />
                    </span>
                    <span class="visually-hidden">
                      {c.combined_seats_covered} of {c.combined_seats_total} seats covered
                      ({c.combined_pct}%)
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="btn-row">
        <a class="btn" href="/parties">Full party coverage</a>
        <a class="btn btn-ghost" href="/parties/issues">Issues &amp; jurisdiction</a>
        <a class="btn btn-ghost" href="/parties/matrix">Policy matrix</a>
        <a class="btn btn-ghost" href="/assembly">All 88 Assembly seats</a>
        <a class="btn btn-ghost" href="/council">All 40 Council seats</a>
        <a class="btn btn-ghost" href="/polls">Poll average</a>
      </p>
    </section>

    <section class="section" aria-labelledby="retire-h">
      <h2 id="retire-h">Open contests</h2>
      <p class="lede">
        <strong>{summary.retirements}</strong> sitting members have confirmed they will not
        recontest (dated sources). That includes{" "}
        <strong>{openSeats}</strong> Assembly seats that will be open contests.
      </p>
      <ul class="retire-strip" role="list">
        {
          retireByParty.map((p) => (
            <li>
              <span class="swatch" style={`--party-colour:${partyColour(p.slug)}`} aria-hidden="true" />
              <span class="rp-count">{p.count}</span>
              <span class="rp-name">{p.short_name}</span>
            </li>
          ))
        }
      </ul>
      <p class="btn-row">
        <a class="btn btn-ghost" href="/open-seats">Full open seats &amp; retirements</a>
        <a class="btn btn-ghost" href="/data/vic2026/retirements.json">retirements.json</a>
      </p>
    </section>

    <section class="section video-home" aria-labelledby="video-home-h">
      <h2 id="video-home-h">How this tracker works</h2>
      <p class="muted video-home-lead">
        Optional explainer. Figures in the video are a snapshot — live numbers on this site
        update as records are verified.
      </p>
      <YouTubeLite
        id={VIDEOS.tracker.id}
        title={VIDEOS.tracker.title}
        blurb={VIDEOS.tracker.blurb}
      />
    </section>

    <AdRow />

    <section class="section trust" aria-labelledby="trust-h">
      <h2 id="trust-h">How to check our work</h2>
      <div class="card-grid">
        <a class="card link-card" href="/methodology">
          <h3>Methodology</h3>
          <p>Statuses, evidence rules, and how coverage is counted.</p>
        </a>
        <a class="card link-card" href="/data">
          <h3>Open data</h3>
          <p>JSON and CSV under CC BY 4.0 — same facts as the HTML.</p>
        </a>
        <a class="card link-card" href={SITE.repo}>
          <h3>Source repository</h3>
          <p>Every change is a reviewable commit in a public Git repo.</p>
        </a>
        <a class="card link-card" href={SITE.issues}>
          <h3>Submit a correction</h3>
          <p>Tip a candidacy with a public source URL and date.</p>
        </a>
        <a class="card link-card" href="/about">
          <h3>Independence</h3>
          <p>Who publishes this site and how it stays non-partisan.</p>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(60rem 22rem at 12% -8%, var(--accent-wash), transparent 70%),
      var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .hero h1 {
    max-width: 20ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 1.6rem 0 0;
  }
  .prelaunch {
    margin-top: 1.75rem;
    max-width: 48rem;
  }
  /* Even vertical rhythm: countdown + sections share one spacing scale */
  .home-body {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .home-body :global(.countdown) {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }
  .home-body > .section {
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .paths h2,
  .section > h2 {
    margin: 0 0 0.85rem;
    font-size: 1.25rem;
  }
  .caveat {
    margin-bottom: 1.25rem;
  }
  .after-stats {
    margin-top: 0.9rem;
  }
  .teaser {
    margin-bottom: 1rem;
  }
  .held-split {
    font-size: 0.82em;
    font-weight: 400;
  }
  .party-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .bar {
    display: block;
    height: 0.45rem;
    min-width: 4.5rem;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar-fill {
    display: block;
    height: 100%;
    background: var(--party-colour, var(--accent));
    border-radius: inherit;
  }
  .mono {
    font-variant-numeric: tabular-nums;
  }
  .retire-strip {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
  }
  .retire-strip li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .rp-count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .video-home-lead {
    margin: 0 0 0.85rem;
    max-width: 40rem;
  }
</style>
