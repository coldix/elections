---
import Base from "../layouts/Base.astro";
import YouTubeLite from "../components/YouTubeLite.astro";
import { SITE, formatDateLong } from "../lib/site.mjs";
import { VIDEOS, YOUTUBE_CHANNEL, watchUrl } from "../lib/videos.mjs";
import { loadElection } from "../../../scripts/lib/data.mjs";

const data = loadElection("vic2026");
const electionDay = data.election.election_day;
const keyDates = [...(data.election.dates || [])].sort((a, b) =>
  a.date.localeCompare(b.date)
);
const rollClose = keyDates.find((d) => /roll closes|electoral roll/i.test(d.event ?? ""));
const nominationsOpen = keyDates.find((d) => /nominations open/i.test(d.event ?? ""));
const nominationsClose = keyDates.find((d) => /nominations close/i.test(d.event ?? ""));
const rollCloseDate = rollClose?.date;

const links = [
  {
    name: "Victorian Electoral Commission",
    url: "https://www.vec.vic.gov.au/",
    note: "Authoritative source for state elections",
  },
  {
    name: "2026 Victorian state election",
    url: "https://www.vec.vic.gov.au/voting/2026-state-election",
    note: "Key dates and official election information",
  },
  {
    name: "Enrol to vote (VEC)",
    url: "https://www.vec.vic.gov.au/enrolment/enrol-to-vote",
    note: "Who must enrol and how",
  },
  {
    name: "Enrol or update online (AEC)",
    url: "https://www.aec.gov.au/enrol/",
    note: "Joint federal / state / council enrolment",
  },
  {
    name: "Check or update my enrolment (AEC)",
    url: "https://check.aec.gov.au/",
    note: "Confirm you are on the roll",
  },
  {
    name: "Fines and reviews (VEC)",
    url: "https://www.vec.vic.gov.au/voting/fines-and-reviews",
    note: "What happens if you do not vote",
  },
  {
    name: "Preferential voting (VEC)",
    url: "https://www.vec.vic.gov.au/voting/how-voting-works/preferential-voting",
    note: "How preferences work in Victoria",
  },
  {
    name: "How to fill out state ballot papers (VEC)",
    url: "https://www.vec.vic.gov.au/voting/learn-to-vote/how-to-fill-out-state-ballot-papers",
    note: "Lower house and upper house ballots",
  },
  {
    name: "How voting works (VEC)",
    url: "https://www.vec.vic.gov.au/voting/how-voting-works",
    note: "Overview of the voting system",
  },
  {
    name: "VoterAlert reminders (VEC)",
    url: "https://www.vec.vic.gov.au/enrolment/voteralert",
    note: "Free enrolment and voting reminders",
  },
  {
    name: "Information in your language (VEC)",
    url: "https://www.vec.vic.gov.au/information-in-your-language",
    note: "Interpreters and translated materials",
  },
];
---

<Base
  title="How to vote in Victoria 2026"
  description="How to vote in the 2026 Victorian state election on Saturday 28 November: enrolment, early voting from 18 November, postal votes, filling in both ballot papers and how-to-vote cards, sourced to the VEC."
>
  <div class="wrap wrap-narrow section">
    <p class="eyebrow">Voters</p>
    <h1>How to vote in Victoria 2026</h1>
    <p class="lede">
      A plain-language guide to enrolment, compulsory voting and preferential voting for the
      Victorian state election. This page summarises public information from the electoral
      commissions. It is <strong>not</strong> legal advice and not a recommendation for any
      candidate or party.
    </p>

    <div class="notice" role="note">
      <strong>The Victorian Electoral Commission is authoritative.</strong> Rules, dates,
      fine amounts and ballot instructions can change. Always confirm on the
      <a href="https://www.vec.vic.gov.au/" rel="noopener">VEC website</a> before you act.
      This site is not affiliated with the VEC or the Australian Electoral Commission.
    </div>

    <p>
      The next Victorian state election is on
      <strong>{formatDateLong(electionDay)}</strong>. You will vote for both houses of the
      Parliament of Victoria:
    </p>
    <ul>
      <li>
        <strong>Legislative Assembly</strong> (lower house) — one member for your local
        district (88 seats statewide).
      </li>
      <li>
        <strong>Legislative Council</strong> (upper house) — five members for your region
        (8 regions, 40 seats).
      </li>
    </ul>
    <p class="muted">
      Official election page:{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election" rel="noopener">
        VEC — 2026 state election</a
      >.{" "}
      <a
        href="https://www.vec.vic.gov.au/electoral-boundaries/which-boundaries-cover-where-i-live"
        rel="noopener"
      >
        Find my district (VEC)</a
      >.
    </p>

    <h2 id="at-a-glance">2026 at a glance</h2>
    <ul>
      <li><strong>Enrol or update</strong> by 8 pm Tuesday 3 November.</li>
      <li><strong>Postal vote applications</strong> open 9 am Wednesday 4 November and close 6 pm Wednesday 25 November.</li>
      <li><strong>Early voting</strong> runs Wednesday 18 to Friday 27 November, 9 am to 6 pm, except Sunday 22 November.</li>
      <li><strong>Low-sensory voting</strong> in every district on Tuesday 17 November, 10 am to 4 pm.</li>
      <li><strong>Election day</strong> is Saturday 28 November. You can vote at any voting centre in Victoria.</li>
      <li><strong>Upper house:</strong> number at least 5 boxes, either above the line or below it.</li>
    </ul>
    <p class="muted">
      Sources:{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election" rel="noopener">VEC, 2026 state election</a>
      ·{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election/voting-options" rel="noopener">VEC, Voting options</a>
      ·{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election/postal-voting" rel="noopener">VEC, Vote by post</a>
      (accessed 1 November 2026).
    </p>

    <h2 id="dates">Key dates</h2>
    <p class="muted">
      From this site’s election record (cross-check the VEC before you act — commissions
      can amend times).
    </p>
    <ul class="key-dates">
      {
        keyDates.map((d) => (
          <li>
            <strong>{formatDateLong(d.date)}</strong> — {d.event}
          </li>
        ))
      }
    </ul>

    <h2 id="eligibility">Who must enrol</h2>
    <p>
      According to the
      <a href="https://www.vec.vic.gov.au/enrolment/enrol-to-vote" rel="noopener">VEC</a>,
      you <strong>must enrol to vote</strong> if you:
    </p>
    <ul>
      <li>are an Australian citizen,</li>
      <li>are 18 or older, <strong>and</strong></li>
      <li>have lived in Victoria for longer than a month.</li>
    </ul>
    <p>
      You must enrol within <strong>21 days</strong> of meeting those requirements. If you
      are 17, you can fill out an enrolment form now; the commission can enrol you
      automatically when you turn 18.
    </p>
    <p>
      A smaller group of British subjects who were on an Australian electoral roll between
      26 October 1983 and 26 January 1984, and who live at a Victorian address, must also
      enrol — see the VEC enrol page for the exact wording.
    </p>
    <p class="muted">
      Source:{" "}
      <a href="https://www.vec.vic.gov.au/enrolment/enrol-to-vote" rel="noopener">
        vec.vic.gov.au — Enrol to vote</a>
      (accessed 29 July 2026).
    </p>

    <h2 id="compulsory">Compulsory voting</h2>
    <p>
      Voting is compulsory in Australia for people who are enrolled. In Victoria, if you
      are enrolled you must vote in federal, state and local council elections. The
      obligation follows <strong>being on the roll</strong>, not whether you care about a
      particular contest.
    </p>
    <p>
      The Australian Electoral Commission (AEC) runs federal elections. The VEC runs
      Victorian state and local council elections.
    </p>
    <p class="muted">
      Source:{" "}
      <a href="https://www.vec.vic.gov.au/voting/fines-and-reviews" rel="noopener">
        vec.vic.gov.au — Fines and reviews</a>.
    </p>

    <h2 id="fines">If you do not vote</h2>
    <p>
      If it looks as though you did not vote, the VEC may write to you. Do not ignore the
      letters — each step can increase what you owe.
    </p>
    <ol>
      <li>
        <strong>Apparent failure to vote notice</strong> — your chance to explain (for
        example, that you did vote, or why you could not). You usually have 28 days to
        respond. This first letter is not itself the fine.
      </li>
      <li>
        <strong>Infringement notice</strong> — a fine, if you do not respond in time or
        your explanation is not accepted.
      </li>
      <li>
        <strong>Penalty reminder notice</strong> — the original fine plus an extra fee if
        you still do not deal with it.
      </li>
      <li>
        <strong>Fines Victoria</strong> — if the matter is still unpaid, the VEC must
        refer it for further enforcement.
      </li>
    </ol>
    <p>
      For elections held between <strong>1 July 2026 and 30 June 2027</strong>, the VEC
      lists the fine for not voting as <strong>$105</strong>. Amounts are set by financial
      year and can change — always check the notice you receive and the
      <a href="https://www.vec.vic.gov.au/voting/fines-and-reviews" rel="noopener">
        VEC fines page</a>.
    </p>
    <p>
      You may be able to request a review, a payment plan, or take the matter to court.
      Valid reasons and processes are decided by the VEC under the law; this site does not
      list exhaustive excuses.
      <a href="https://www.vec.vic.gov.au/voting/fines-and-reviews" rel="noopener">
        Read the full process on the VEC site</a>
      or call <a href="tel:1300551575">1300 551 575</a>.
    </p>

    <h2 id="enrol">How to enrol or update your details</h2>
    <p>
      Victoria works with the AEC so you enrol once for federal, state and local council
      elections.
    </p>
    <p class="btn-row">
      <a class="btn" href="https://www.aec.gov.au/enrol/" rel="noopener">Enrol or update online (AEC)</a>
      <a class="btn btn-ghost" href="https://check.aec.gov.au/" rel="noopener">Check your enrolment (AEC)</a>
      <a class="btn btn-ghost" href="https://www.aec.gov.au/enrol/form.htm" rel="noopener">
        Paper enrolment form (AEC)
      </a>
    </p>
    <p class="muted">
      Or call the VEC on <a href="tel:131832">131 832</a> to have a form posted.
    </p>
    <p>
      When you move house, you need to have lived at the new address for about 30 days
      before updating, then update within 21 days (VEC guidance). Keep your name and
      postal address current so election material reaches you.
    </p>
    <p>
      <strong>For the 2026 state election:</strong>
      {
        rollClose ? (
          <>
            {" "}
            enrol or update by <strong>{formatDateLong(rollClose.date)}</strong>
            {" "}({rollClose.event})
          </>
        ) : (
          <> check the VEC for the enrolment deadline before election day</>
        )
      }
      . Always re-check the{" "}
      <a href="https://www.vec.vic.gov.au/enrolment/enrol-to-vote" rel="noopener">
        VEC enrol page</a>{" "}
      before the deadline
      {nominationsClose && (
        <>
          . Formal nominations close{" "}
          <strong>{formatDateLong(nominationsClose.date)}</strong>
          {nominationsOpen && <> (open {formatDateLong(nominationsOpen.date)})</>}
        </>
      )}
      .
    </p>
    <p>
      Free reminders:{" "}
      <a href="https://www.vec.vic.gov.au/enrolment/voteralert" rel="noopener">
        sign up for VoterAlert</a>.
    </p>

    <h2 id="preferences">How preferential voting works</h2>
    <p>
      Victoria uses <strong>preferential voting</strong>. You rank candidates (or, in the
      upper house, a group) in the order you prefer. If your higher choices cannot win, your
      vote can still count for later preferences — so long as the ballot is filled in
      correctly (a <em>formal</em> vote).
    </p>

    <h3 id="video-ballot">Watch: numbering the ballot</h3>
    <p class="muted">
      Short civic explainer (not how-to-vote advice). Authoritative rules stay with the VEC.
    </p>
    <YouTubeLite
      id={VIDEOS.ballot.id}
      title={VIDEOS.ballot.title}
      blurb={VIDEOS.ballot.blurb}
    />
    <div class="btn-row more-videos">
      <span class="btn-row-label muted">More explainers</span>
      <a class="btn btn-ghost btn-sm" href={watchUrl(VIDEOS.spoiler.id)} rel="noopener">
        Preferential &amp; spoiler effect
      </a>
      <a class="btn btn-ghost btn-sm" href={watchUrl(VIDEOS.machinery.id)} rel="noopener">
        How a state election works
      </a>
      <a class="btn btn-ghost btn-sm" href={YOUTUBE_CHANNEL} rel="noopener">YouTube channel</a>
    </div>

    <h3 id="assembly">Legislative Assembly (lower house)</h3>
    <p>
      One member is elected per district. Full preferential voting applies: you must
      number <strong>every</strong> box.
    </p>
    <ol>
      <li>Write <strong>1</strong> next to the candidate you most want elected.</li>
      <li>Write <strong>2</strong> next to your second choice.</li>
      <li>
        Continue 3, 4, 5… until <strong>every</strong> box has a different number.
      </li>
    </ol>
    <p>
      Counting (in plain terms): first-preference votes are tallied. If no candidate has a
      majority, the last-placed candidate is excluded and their ballots move to each
      voter’s next preference. That continues until one candidate has a majority of votes
      still in the count.
    </p>
    <p>
      The last two candidates still in that count are the district’s
      <strong>two-candidate preferred</strong> (2CP) result. That pair is not always Labor
      versus Coalition — some seats finish Greens versus Labor, Nationals versus Independent,
      or another combination. A separate Labor–Coalition
      <strong>two-party preferred</strong> (2PP) count is sometimes published as well.
      Historical 2022 first-preference and 2CP figures are on each
      <a href="/districts">district page</a>. They are the last election result, not a
      forecast of 2026.
    </p>

    <h3 id="council">Legislative Council (upper house)</h3>
    <p>
      You elect five members for your region on the larger ballot paper. It has a thick
      line across it, and you can vote <strong>above the line</strong> or
      <strong>below the line</strong>, but not both.
    </p>
    <ul>
      <li>
        <strong>Above the line:</strong> number the boxes for groups in your order of choice,
        1, 2, 3 and so on, until you have numbered <strong>at least 5</strong>. Don't write
        any numbers below the line.
      </li>
      <li>
        <strong>Below the line:</strong> number individual candidates 1, 2, 3 and so on until
        you have numbered <strong>at least 5</strong>. You can keep going past 5 if you want.
        Don't write any numbers above the line.
      </li>
    </ul>
    <p>
      Either way, you decide your own preferences. Use numbers only. Ticks, crosses, a zero, missed or
      repeated numbers, or too few numbered boxes can make a vote informal, which means it
      can't be counted. If you make a mistake you can cross it out and write the right number,
      or ask staff for a new ballot paper.
    </p>
    <p class="muted">
      Sources:{" "}
      <a
        href="https://www.vec.vic.gov.au/voting/learn-to-vote/how-to-fill-out-state-ballot-papers"
        rel="noopener"
      >
        VEC, How to fill out state ballot papers</a>
      ·{" "}
      <a href="https://www.vec.vic.gov.au/about-us/legislation/electoral-act-amendments-2026" rel="noopener">
        VEC, 2026 Electoral Act amendments</a>
      (accessed 1 November 2026).
    </p>

    <h3 id="htv">How-to-vote cards</h3>
    <p>
      A how-to-vote card is a printed guide showing how a candidate, party or group would like
      you to number your ballot. It is only a suggestion. You don't have to follow it, and the
      numbers you write are up to you.
    </p>
    <ul>
      <li>
        On election day, registered how-to-vote cards are the only material that can be
        handed out within 400 metres of a voting centre.
      </li>
      <li>
        Anyone can register a card, including independents, parties, community groups,
        businesses, unions and members of the public. Registration runs from Tuesday
        10 November to 12 noon Friday 20 November.
      </li>
      <li>Registered cards will be published on the VEC website.</li>
      <li>
        Cards handed out at early voting centres, or more than 400 metres away on election
        day, don't need to be registered, but every card must be properly authorised.
      </li>
    </ul>
    <p>
      This website does <strong>not</strong> publish preference recommendations or sample
      orderings for any party or candidate.
    </p>
    <p class="muted">
      Source:{" "}
      <a
        href="https://www.vec.vic.gov.au/candidates-and-parties/become-a-state-election-candidate/how-to-vote-cards"
        rel="noopener"
      >
        VEC, How-to-vote card guidelines</a>
      (accessed 1 November 2026).
    </p>

    <h2 id="ways">Ways to vote in 2026</h2>

    <h3 id="early">Vote early in person</h3>
    <p>
      Early voting runs from <strong>Wednesday 18 to Friday 27 November</strong>, 9 am to
      6 pm every day except Sunday 22 November. You don't need a reason to vote early. Every
      early voting centre will also be an election day voting centre. The VEC says it will
      publish early voting locations closer to the voting period, so the list of places is
      <strong>pending</strong> until then.
    </p>

    <h3 id="postal">Vote by post</h3>
    <ul>
      <li>
        Anyone can apply. Applications open <strong>9 am Wednesday 4 November</strong> and
        close <strong>6 pm Wednesday 25 November</strong>. Apply early so the pack has time to
        reach you.
      </li>
      <li>
        Apply online on the VEC postal voting page, or on a paper form from Victorian
        Australia Post offices, VEC head office (Level 11, 530 Collins St, Melbourne) or your
        district election office.
      </li>
      <li>
        If you apply online you choose a verification question. Keep your answer, because you
        must write it on the declaration envelope.
      </li>
      <li>Ballot packs start going out from Wednesday 11 November.</li>
      <li>
        Only the VEC or Australia Post can send you a postal vote application. If one arrives
        from a candidate, party or anyone else, don't fill it out, and report it to the VEC.
      </li>
      <li>
        If you're outside Victoria or your mail is slow, you can ask for an emailed ballot pack
        to print. That isn't online voting. There is no online voting at this election.
      </li>
      <li>
        Fill in your ballot papers in front of a witness (without showing them your vote), seal
        them in the declaration envelope, then sign and date it and have the witness complete
        their part.
      </li>
      <li>
        Post it before <strong>6 pm Saturday 28 November</strong>, or drop it at any early or
        election day voting centre before then. The VEC must receive it by
        <strong>Friday 4 December</strong>.
      </li>
      <li>
        Registered general postal voters don't need to apply. To become one for this
        election, apply before 8 pm Tuesday 3 November.
      </li>
    </ul>

    <h3 id="election-day">Vote on election day</h3>
    <p>
      Election day is <strong>Saturday 28 November 2026</strong>. You can vote at any voting
      centre in Victoria. You'll get two ballot papers, a small one for your district and a
      large one for your region, and you need to complete both. The VEC will publish
      voting centre locations closer to the day, so those are <strong>pending</strong>.
    </p>

    <h3 id="other">Other options</h3>
    <ul>
      <li>
        <strong>Telephone voting</strong> for voters who are blind, have low vision or have a
        motor impairment. Registration and voting open Wednesday 18 November.
      </li>
      <li>
        <strong>Low-sensory voting</strong> in every district, Tuesday 17 November, 10 am to
        4 pm.
      </li>
      <li>
        <strong>Mobile voting</strong> at some nursing homes, aged care facilities, community
        centres and homelessness services.
      </li>
      <li>
        <strong>Away from Victoria:</strong> see the VEC's away from Victoria page for options.
      </li>
    </ul>
    <p class="muted">
      Sources:{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election/voting-options" rel="noopener">VEC, Voting options</a>
      ·{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election/postal-voting" rel="noopener">VEC, Vote by post</a>
      ·{" "}
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election/away-from-victoria" rel="noopener">VEC, Away from Victoria</a>
      (accessed 1 November 2026).
    </p>

    <h2 id="links">Official links</h2>
    <div class="table-scroll">
      <table class="data">
        <caption class="visually-hidden">Official electoral commission links</caption>
        <thead>
          <tr>
            <th scope="col">Resource</th>
            <th scope="col">What it is for</th>
          </tr>
        </thead>
        <tbody>
          {
            links.map((l) => (
              <tr>
                <th scope="row">
                  <a href={l.url} rel="noopener">
                    {l.name}
                  </a>
                </th>
                <td class="muted">{l.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="not-advice">What this page is not</h2>
    <ul>
      <li>Not voting advice, a how-to-vote card, or a preference recommendation.</li>
      <li>Not legal advice about fines, reviews or special circumstances.</li>
      <li>
        Not a substitute for the VEC or AEC. If anything here differs from a commission
        publication, the commission is correct.
      </li>
      <li>Not about who is standing — use the candidate indexes below.</li>
    </ul>
    <p class="btn-row">
      <a class="btn" href="/assembly">Assembly districts</a>
      <a class="btn btn-ghost" href="/marginal-seats">Marginal seats</a>
      <a class="btn btn-ghost" href="/">Homepage</a>
      <a class="btn btn-ghost" href="/disclaimer">Disclaimer</a>
      <a class="btn btn-ghost" href="/about">About</a>
    </p>

    <p class="foot muted">
      Reviewed against public VEC and AEC pages as of 1 November 2026.
    </p>
  </div>
</Base>

<style>
  h2 {
    margin-top: 2.5rem;
  }
  h3 {
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }
  .more-videos {
    margin: 0.25rem 0 1.5rem;
  }
  .key-dates {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.45rem;
    margin: 0 0 1.5rem;
    color: var(--ink-2);
  }
  ul,
  ol {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    color: var(--ink-2);
  }
  ul strong,
  ol strong {
    color: var(--ink);
  }
  .notice {
    margin: 1.25rem 0;
  }
  .foot {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
</style>
