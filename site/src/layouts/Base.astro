---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, socialLinks } from "../lib/site.mjs";

const {
  title,
  description = SITE.tagline,
  /** Page-specific JSON-LD. Appended to the sitewide graph below. */
  schema = null,
  /** BreadcrumbList trail: [{ name, href }], innermost last. */
  breadcrumbs = null,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url).href;
// Absolute URL required — Facebook and other scrapers do not resolve relative
// paths for og:image.
const ogImage = new URL("/images/og-image.jpg", SITE.url).href;
const logoUrl = new URL("/icon-512.png", SITE.url).href;

// Sitewide structured data. Emitted on every page as a @graph so search engines
// and AI systems can identify the publisher and the site without inferring it,
// and so citations attribute the right organisation.
const graph = [
  {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    alternateName: [SITE.short, "electiontracker.au"],
    url: SITE.url,
    logo: {
      "@type": "ImageObject",
      url: logoUrl,
      width: 512,
      height: 512,
    },
    image: logoUrl,
    description: SITE.descriptionLong,
    email: SITE.email,
    areaServed: { "@type": "Country", name: "Australia" },
    knowsAbout: [
      "Australian elections",
      "Victorian state election 2026",
      "Legislative Assembly candidates",
      "Legislative Council candidates",
      "election polling Australia",
      "open election data",
    ],
    sameAs: [...socialLinks().map((s) => s.url), SITE.repo],
    publishingPrinciples: `${SITE.url}/methodology`,
    ethicsPolicy: `${SITE.url}/about`,
    parentOrganization: {
      "@type": "Organization",
      name: SITE.publisher,
      url: SITE.publisherUrl,
    },
  },
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    alternateName: SITE.short,
    description: SITE.descriptionLong,
    inLanguage: "en-AU",
    isAccessibleForFree: true,
    publisher: { "@id": `${SITE.url}/#organization` },
    license: "https://creativecommons.org/licenses/by/4.0/",
    copyrightHolder: { "@id": `${SITE.url}/#organization` },
    about: [
      { "@type": "Thing", name: "Elections in Australia" },
      { "@type": "Thing", name: "2026 Victorian state election" },
    ],
  },
  {
    // Helps AI systems and browsers discover the machine + AI entry points.
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": `${SITE.url}/#organization` },
    inLanguage: "en-AU",
    isAccessibleForFree: true,
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImage,
      width: 1200,
      height: 630,
    },
  },
];

if (breadcrumbs?.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: new URL(b.href, SITE.url).href,
    })),
  });
}

if (schema) graph.push(...(Array.isArray(schema) ? schema : [schema]));

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Apply saved / system theme before paint to avoid a flash of the wrong palette. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("aet-theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        /* Allow full snippets and large image previews — this site wants to be
           quoted at length and cited, not teased. */
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Have your say — monthly voting survey at survey.oze.net.au" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Single-locale site; explicit hreflang helps search engines and AI crawlers. */}
    <link rel="alternate" hreflang="en-AU" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    {
      /* Homepage only — Google reads it there, and repeating it on 115 pages
         would be noise. */
      canonical === `${SITE.url}/` && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/json" href="/data/index.json" title="Open data index" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Guide for AI systems (summary)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Guide for AI systems (full)" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      /* Google Analytics 4 — sitewide page views. Measurement ID from SITE.gaMeasurementId.
         See docs/decisions.md ADR-12 and /privacy. Inline so the ID is baked into static HTML. */
      SITE.gaMeasurementId ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.gaMeasurementId}');`}
          />
        </>
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
