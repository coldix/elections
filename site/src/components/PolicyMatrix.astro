---
/**
 * Policy comparison shell.
 * Default: four-column view with Liberal and Nationals consolidated as a
 * virtual Coalition column. The five-party view remains available without
 * changing the underlying records.
 */
import PolicyMatrixView from "./PolicyMatrixView.astro";

const { matrix } = Astro.props;
const separate = {
  parties: matrix.parties,
  rows: matrix.rows,
  stats: matrix.stats,
};
const combined = matrix.combined ?? null;
const defaultView = combined ? matrix.default_view : "separate";
const activeStats = defaultView === "combined" ? combined.stats : separate.stats;
const fillPct = activeStats.total_cells
  ? Math.round((activeStats.filled_cells / activeStats.total_cells) * 100)
  : 0;
---

<section class="pm" aria-labelledby="pm-h" data-policy-matrix data-default-view={defaultView}>
  <div class="pm-intro">
    <p class="eyebrow">Party positions · sourced only</p>
    <h2 id="pm-h">Policy comparison matrix</h2>
    <p class="lede">
      The default view consolidates joint Liberal–Nationals commitments into one
      Coalition column. Switch to the separate-party view whenever their records,
      emphasis or published positions differ.
    </p>

    <div class="pm-progress" aria-hidden="true">
      <div class="pm-progress-bar">
        <span class="pm-progress-fill" style={`width:${fillPct}%`} />
      </div>
    </div>
    <p class="pm-stats muted">
      <strong>{matrix.stats.policy_records}</strong> underlying party policy records ·{" "}
      <strong>{matrix.stats.claims}</strong> sourced claim{matrix.stats.claims === 1 ? "" : "s"} ·{" "}
      <strong>{matrix.stats.issues}</strong> issues
    </p>
  </div>

  <div class="notice" role="note">
    {matrix.caveat}{" "}
    A combined Coalition cell is a display convenience only: Liberal and Nationals
    remain separate parties and their original records remain available in the
    separate view and open data. See <a href="/methodology#policy-matrix">methodology</a>.
  </div>

  <ul class="pm-legend" aria-label="How to read the matrix">
    <li>
      <span class="lg-shared">Shared Coalition policy</span>
      <span class="muted">A joint commitment shown once</span>
    </li>
    <li>
      <span class="lg-mixed">Shared + differences</span>
      <span class="muted">Joint platform with party-specific material</span>
    </li>
    <li>
      <span class="lg-fed">Federal policy</span>
      <span class="muted">National party position, not a state-only pledge</span>
    </li>
    <li>
      <span class="lg-empty">Empty cell</span>
      <span class="muted">No sourced record yet</span>
    </li>
  </ul>

  {combined && (
    <div class="pm-view-switch" role="tablist" aria-label="Matrix display mode">
      <button
        type="button"
        role="tab"
        data-view-switch="combined"
        aria-selected={defaultView === "combined" ? "true" : "false"}
      >
        Coalition combined
        <span>4 columns</span>
      </button>
      <button
        type="button"
        role="tab"
        data-view-switch="separate"
        aria-selected={defaultView === "separate" ? "true" : "false"}
      >
        Parties separate
        <span>5 columns</span>
      </button>
    </div>
  )}

  {combined && (
    <div data-view-panel="combined" hidden={defaultView !== "combined"}>
      <PolicyMatrixView view={combined} mode="combined Coalition" viewId="combined" />
    </div>
  )}

  <div data-view-panel="separate" hidden={defaultView !== "separate"}>
    <PolicyMatrixView view={separate} mode="separate party" viewId="separate" />
  </div>
</section>

<script>
  const initialisePolicyMatrixViews = () => {
    document.querySelectorAll("[data-policy-matrix]").forEach((matrix) => {
      if (matrix.dataset.viewSwitchReady === "true") return;
      matrix.dataset.viewSwitchReady = "true";

      const buttons = [...matrix.querySelectorAll("[data-view-switch]")];
      const panels = [...matrix.querySelectorAll("[data-view-panel]")];
      if (!buttons.length) return;

      const show = (view) => {
        buttons.forEach((button) => {
          button.setAttribute("aria-selected", String(button.dataset.viewSwitch === view));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.viewPanel !== view;
        });
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => show(button.dataset.viewSwitch));
      });
    });
  };

  initialisePolicyMatrixViews();
  document.addEventListener("astro:page-load", initialisePolicyMatrixViews);
</script>

<style>
  .pm-intro {
    margin-bottom: 1rem;
  }

  .pm-progress {
    max-width: 22rem;
    margin: 0.85rem 0 0.35rem;
  }

  .pm-progress-bar {
    height: 0.45rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface-2);
  }

  .pm-progress-fill {
    display: block;
    min-width: 0.25rem;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--accent) 0%,
      color-mix(in srgb, var(--accent) 70%, var(--st-endorsed)) 100%
    );
  }

  .pm-stats {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }

  .pm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    list-style: none;
    font-size: 0.84rem;
  }

  .pm-legend li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .lg-shared,
  .lg-mixed,
  .lg-fed {
    padding: 0.14rem 0.42rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .lg-shared {
    border-color: color-mix(in srgb, #315b82 48%, var(--rule));
    background: color-mix(in srgb, #315b82 9%, var(--surface));
  }

  .lg-mixed {
    border-color: color-mix(in srgb, #0b7a4b 42%, var(--rule));
    background: color-mix(in srgb, #0b7a4b 8%, var(--surface));
  }

  .lg-fed {
    border-color: color-mix(in srgb, var(--st-announced) 45%, var(--rule));
    background: var(--st-announced-bg);
    color: var(--st-announced);
  }

  .lg-empty {
    color: var(--ink-3);
    font-size: 0.8rem;
    font-style: italic;
  }

  .pm-view-switch {
    display: inline-flex;
    gap: 0.3rem;
    margin: 0.25rem 0 1rem;
    padding: 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface-2);
  }

  .pm-view-switch button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.48rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .pm-view-switch button span {
    color: var(--ink-3);
    font-size: 0.7rem;
    font-weight: 550;
  }

  .pm-view-switch button[aria-selected="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .pm-view-switch button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [data-view-panel][hidden] {
    display: none;
  }

  @media (max-width: 34rem) {
    .pm-view-switch {
      display: grid;
      width: 100%;
      border-radius: var(--radius);
    }

    .pm-view-switch button {
      justify-content: center;
    }
  }
</style>
