---
import { SITE, ATTRIBUTION, socialLinks } from "../lib/site.mjs";
import buildMeta from "../generated/build-meta.json";

const year = new Date().getFullYear();
const social = socialLinks();
const versionLabel = buildMeta?.version ?? "dev";
const builtAest = buildMeta?.built_at_aest ?? null;
const repoCommit = buildMeta?.git_sha_full
  ? `${SITE.repo}/commit/${buildMeta.git_sha_full}`
  : SITE.repo;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="eyebrow">Australian Election Tracker</p>
        <p class="muted">
          {SITE.tagline}. Published by {SITE.publisher}. Not affiliated with the Victorian
          Electoral Commission, any political party or any candidate.
        </p>
      </div>

      <div>
        <p class="eyebrow">Data &amp; method</p>
        <ul>
          <li><a href="/latest">What's new</a></li>
          <li><a href="/methodology">Methodology &amp; source standards</a></li>
          <li><a href="/polls">Poll average</a></li>
          <li><a href="/open-seats">Open seats &amp; retirements</a></li>
          <li><a href="/data">Open data (JSON &amp; CSV)</a></li>
          <li><a href={SITE.repo}>Source repository</a></li>
          <li><a href={SITE.issues}>Submit a correction</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">About</p>
        <ul>
          <li><a href="/voting">Voting in Victoria</a></li>
          <li><a href="/about">Independence statement</a></li>
          <li><a href="/about#authorisation">Legal authorisation</a></li>
          <li><a href="/about#contact">Contact</a></li>
          {
            social.map((s) => (
              <li>
                <a href={s.url} rel="me noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms of use</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-meta muted">
        <span class="licence">
          Code MIT-licensed. Election data published under
          <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a> —
          free to reuse with attribution to {ATTRIBUTION}.
        </span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="copyright">© {year} {SITE.publisher}.</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="build-stamp">
          <span class="build-label">Build</span>
          <a class="build-ver" href={repoCommit} rel="noopener" title="Git commit for this deploy">
            {versionLabel}
          </a>
          {
            builtAest && (
              <>
                <span class="build-sep" aria-hidden="true">·</span>
                <time datetime={buildMeta.built_at_utc}>{builtAest}</time>
              </>
            )
          }
        </span>
      </p>

      <a class="design-credit" href="https://oze.au" rel="noopener">
        <span class="design-credit-text">Website design</span>
        <img
          class="design-credit-logo"
          src="/images/oze-logo.png"
          alt="Oze"
          width="88"
          height="41"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
    padding-block: clamp(2rem, 5vw, 3.25rem) 2rem;
    margin-top: 4rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.75rem 2.5rem;
  }
  .cols p.muted {
    max-width: 32rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .footer-bottom {
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .footer-meta {
    flex: 1 1 18rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    max-width: 52rem;
  }
  .meta-sep {
    margin: 0 0.4rem;
    opacity: 0.45;
  }
  .build-stamp {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .build-label {
    font-weight: 620;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-right: 0.3rem;
    color: var(--ink-3);
    font-size: 0.72rem;
  }
  .build-ver {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 560;
    color: var(--ink-2);
    text-decoration: none;
  }
  .build-ver:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .build-sep {
    margin: 0 0.3rem;
    opacity: 0.5;
  }
  @media (max-width: 40rem) {
    .build-stamp {
      white-space: normal;
    }
  }
  .design-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 520;
    flex: none;
  }
  .design-credit:hover {
    color: var(--ink);
  }
  .design-credit:hover .design-credit-logo {
    opacity: 1;
  }
  .design-credit-text {
    letter-spacing: 0.01em;
  }
  .design-credit-logo {
    width: 4.4rem;
    height: auto;
    opacity: 0.92;
    transition: opacity 0.15s ease;
  }
</style>
