---
import { SITE, ATTRIBUTION, socialLinks } from "../lib/site.mjs";
const year = new Date().getFullYear();
const social = socialLinks();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="eyebrow">Australian Election Tracker</p>
        <p class="muted">
          {SITE.tagline}. Published by {SITE.publisher}. Not affiliated with the Victorian
          Electoral Commission, any political party or any candidate.
        </p>
      </div>

      <div>
        <p class="eyebrow">Data &amp; method</p>
        <ul>
          <li><a href="/methodology">Methodology &amp; source standards</a></li>
          <li><a href="/polls">Poll average</a></li>
          <li><a href="/data">Open data (JSON &amp; CSV)</a></li>
          <li><a href={SITE.repo}>Source repository</a></li>
          <li><a href={SITE.issues}>Submit a correction</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">About</p>
        <ul>
          <li><a href="/voting">Voting in Victoria</a></li>
          <li><a href="/about">Independence statement</a></li>
          <li><a href="/about#authorisation">Legal authorisation</a></li>
          <li><a href="/about#contact">Contact</a></li>
          {
            social.map((s) => (
              <li>
                <a href={s.url} rel="me noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms of use</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="licence muted">
        Code MIT-licensed. Election data published under
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a> —
        free to reuse with attribution to {ATTRIBUTION}. © {year} {SITE.publisher}.
      </p>

      <a class="design-credit" href="https://oze.au" rel="noopener">
        <span class="design-credit-text">Website design</span>
        <img
          class="design-credit-logo"
          src="/images/oze-logo.png"
          alt="Oze"
          width="88"
          height="41"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
    padding-block: clamp(2rem, 5vw, 3.25rem) 2rem;
    margin-top: 4rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.75rem 2.5rem;
  }
  .cols p.muted {
    max-width: 32rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .footer-bottom {
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }
  .licence {
    margin: 0;
    font-size: 0.83rem;
    flex: 1 1 16rem;
    max-width: 42rem;
  }
  .design-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 520;
    flex: none;
  }
  .design-credit:hover {
    color: var(--ink);
  }
  .design-credit:hover .design-credit-logo {
    opacity: 1;
  }
  .design-credit-text {
    letter-spacing: 0.01em;
  }
  .design-credit-logo {
    width: 4.4rem;
    height: auto;
    opacity: 0.92;
    transition: opacity 0.15s ease;
  }
</style>
