---
/** Headline counts. Every figure is derived from data/ at build time. */
const { stats } = Astro.props;
---

<ul class="stats" role="list">
  {
    stats.map((s) => (
      <li>
        <span class="v">{s.value}</span>
        <span class="k">{s.label}</span>
        {s.note && <span class="n">{s.note}</span>}
      </li>
    ))
  }
</ul>

<style>
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stats li {
    background: var(--surface);
    padding: 1.05rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .v {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.05rem);
    font-weight: 690;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
  }
  .k {
    font-size: 0.83rem;
    color: var(--ink-2);
    font-weight: 520;
  }
  .n {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
</style>
