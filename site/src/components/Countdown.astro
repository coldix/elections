---
/**
 * Live countdown to election-day polls open (indicative 8:00 AEDT/AEST Melbourne).
 * Days/hours/minutes/seconds rendered at BUILD for no-JS; inline script ticks every second.
 * Label is careful: VEC is authoritative for poll hours and early voting.
 */
import { daysUntil } from "../../../scripts/lib/data.mjs";
import { formatDateLong } from "../lib/site.mjs";

const { election, keyDates = [] } = Astro.props;
const iso = election.election_day;
// Typical Victorian election-day poll opening (AEDT in late November); confirm with VEC nearer the day.
// Fixed +11 is correct for 2026-11-28 Melbourne; do not use bare local parse (CI is UTC).
const targetIso = `${iso}T08:00:00+11:00`;
const targetMs = new Date(targetIso).getTime();

function partsFromMs(ms) {
  const total = Math.max(0, Math.floor(ms / 1000));
  const d = Math.floor(total / 86400);
  const h = Math.floor((total % 86400) / 3600);
  const m = Math.floor((total % 3600) / 60);
  const s = total % 60;
  const pad = (n, w = 2) => String(n).padStart(w, "0");
  return {
    d: pad(d, 3),
    h: pad(h),
    m: pad(m),
    s: pad(s),
    totalDays: Math.ceil(ms / 86400000),
  };
}

const initial = partsFromMs(targetMs - Date.now());
const daysLabel = daysUntil(iso);
---

<div class="countdown card">
  <div class="cd-main">
    <p class="eyebrow">Countdown</p>
    {/* Deliberately not a heading: this card sits inside a section already
        titled with the election name, and a second h2 carrying identical text
        is a duplicate for screen readers and search engines. */}
    <p class="cd-title">{election.name}</p>
    <p class="cd-date">
      <time datetime={iso}>{formatDateLong(iso)}</time>
      <span class="cd-date-sub"> · election day</span>
    </p>
    <p class="muted cd-note">
      Clock to <strong>polls open</strong> (indicative 8:00 Melbourne time). Early voting and
      exact hours: always check the
      <a href="https://www.vec.vic.gov.au/voting/2026-state-election" rel="noopener">VEC</a>.
    </p>
  </div>

  <div
    class="cd-clock"
    role="timer"
    aria-live="polite"
    aria-atomic="true"
    data-countdown-clock
    data-target={targetIso}
  >
    <p class="cd-clock-label" id="cd-clock-label">Until polls open</p>
    <div class="cd-grid mono" aria-labelledby="cd-clock-label">
      <div class="cd-cell">
        <span class="cd-part" data-cd="d">{initial.d}</span>
        <span class="cd-unit">days</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-cell">
        <span class="cd-part" data-cd="h">{initial.h}</span>
        <span class="cd-unit">hrs</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-cell">
        <span class="cd-part" data-cd="m">{initial.m}</span>
        <span class="cd-unit">min</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-cell">
        <span class="cd-part" data-cd="s">{initial.s}</span>
        <span class="cd-unit">sec</span>
      </div>
    </div>
    <p class="visually-hidden" data-cd-spoken>
      {daysLabel} days until election day
    </p>
  </div>

  {
    keyDates.length > 0 && (
      <ol class="cd-dates">
        {keyDates.map((d) => {
          const past = daysUntil(d.date) < 0;
          return (
            <li class={past ? "past" : undefined}>
              <time datetime={d.date}>{formatDateLong(d.date)}</time>
              <span>{d.event}</span>
            </li>
          );
        })}
      </ol>
    )
  }
</div>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-countdown-clock]");
    if (!root) return;
    var target = new Date(root.getAttribute("data-target")).getTime();
    if (!isFinite(target)) return;

    function pad(n, w) {
      w = w || 2;
      var s = String(Math.max(0, n | 0));
      while (s.length < w) s = "0" + s;
      return s;
    }

    function tick() {
      var ms = target - Date.now();
      if (ms < 0) ms = 0;
      var total = Math.floor(ms / 1000);
      var d = Math.floor(total / 86400);
      var h = Math.floor((total % 86400) / 3600);
      var m = Math.floor((total % 3600) / 60);
      var s = total % 60;
      var set = function (key, val) {
        var el = root.querySelector('[data-cd="' + key + '"]');
        if (el) el.textContent = val;
      };
      set("d", pad(d, 3));
      set("h", pad(h, 2));
      set("m", pad(m, 2));
      set("s", pad(s, 2));
      var spoken = root.querySelector("[data-cd-spoken]");
      if (spoken) {
        spoken.textContent =
          d +
          " days, " +
          h +
          " hours, " +
          m +
          " minutes, " +
          s +
          " seconds until polls open";
      }
      if (ms === 0 && root.getAttribute("data-done") !== "1") {
        root.setAttribute("data-done", "1");
        var lab = root.querySelector(".cd-clock-label");
        if (lab) lab.textContent = "Election day";
      }
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>

<style>
  .countdown {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem 2rem;
    align-items: start;
    box-shadow: var(--shadow);
  }
  /* Styled as a heading, marked up as a paragraph — see the note in the markup. */
  .cd-title {
    margin: 0 0 0.25rem;
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.7rem);
    font-weight: 640;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cd-date {
    margin: 0 0 0.5rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  .cd-date-sub {
    color: var(--ink-3);
  }
  .cd-note {
    margin: 0;
    max-width: 28rem;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .cd-clock {
    text-align: right;
    min-width: min(100%, 20rem);
  }
  .cd-clock-label {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    font-weight: 660;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cd-grid {
    display: inline-flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.15rem 0.2rem;
    margin: 0;
  }
  .cd-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 2.75rem;
  }
  .cd-cell:first-child {
    min-width: 3.35rem;
  }
  .cd-part {
    display: block;
    font-size: clamp(1.7rem, 1.15rem + 2.2vw, 2.6rem);
    font-weight: 720;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
    line-height: 1;
  }
  .cd-unit {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    line-height: 1.2;
  }
  .cd-sep {
    align-self: flex-start;
    padding-top: 0.15em;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.2rem);
    font-weight: 500;
    color: var(--ink-2);
    opacity: 0.55;
    line-height: 1;
  }
  .cd-dates {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem 1.5rem;
    font-size: 0.88rem;
  }
  .cd-dates li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0.7rem;
    border-left: 2px solid var(--accent);
  }
  .cd-dates li.past {
    border-left-color: var(--rule-strong);
    color: var(--ink-3);
  }
  .cd-dates time {
    font-weight: 620;
  }
  .cd-dates span {
    color: var(--ink-3);
  }
  .cd-dates li.past time {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 40rem) {
    .countdown {
      grid-template-columns: 1fr;
    }
    .cd-clock {
      text-align: left;
      min-width: 0;
    }
    .cd-grid {
      justify-content: flex-start;
    }
  }
</style>
