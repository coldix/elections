---
/**
 * Headline poll average: big primaries and a prominent as-of date.
 * Party colours are data visualisation only (never site chrome).
 */
import { PARTY_LABELS } from "../../../scripts/lib/polls.mjs";
import { formatDate, partyColour } from "../lib/site.mjs";

const PARTY_ORDER = [
  { key: "alp", colourSlug: "labor", short: "Labor" },
  { key: "lnp", colourSlug: "coalition", short: "Coalition" },
  { key: "onp", colourSlug: "one-nation", short: "One Nation" },
  { key: "grn", colourSlug: "greens", short: "Greens" },
  { key: "others", colourSlug: "independent", short: "Others" },
];

const COPY = {
  vic: {
    kicker: "Victorian Legislative Assembly",
    frame: "statewide primary vote",
    otherKind: "federal House",
  },
  federal: {
    kicker: "Federal House of Representatives",
    frame: "national primary vote",
    otherKind: "Victorian Assembly",
  },
};

const {
  average,
  jurisdiction,
  variant = "page",
  href,
  other,
} = Astro.props;

const copy = COPY[jurisdiction];
const teaser = variant === "teaser";
const ok = average?.status === "ok" && average.primaries;
const asOfLabel = average?.as_of ? formatDate(average.as_of) : null;
const pollCount = average?.included_poll_ids?.length ?? 0;

function fmt(n) {
  return Number(n).toFixed(1);
}
---

{
  ok ? (
    teaser ? (
      <a
        class="poll-board teaser card-interactive"
        href={href}
        data-election={jurisdiction}
        data-as-of={average.as_of}
      >
        <div class="board-head">
          <p class="eyebrow">{copy.kicker}</p>
          <p class="as-of">
            <span class="as-of-kicker">As of</span>
            <time datetime={average.as_of}>{asOfLabel}</time>
          </p>
        </div>
        <ul class="shares" role="list">
          {PARTY_ORDER.map((p) => (
            <li style={`--party-colour:${partyColour(p.colourSlug)}`}>
              <span class="party">{p.short}</span>
              <span class="pct mono">{fmt(average.primaries[p.key])}%</span>
            </li>
          ))}
        </ul>
        <p class="board-foot">
          {pollCount} polls in the average · {copy.frame} · not a forecast
          <span class="more">Full ledger</span>
        </p>
      </a>
    ) : (
      <section
        class="poll-board page"
        aria-labelledby="avg-heading"
        data-election={jurisdiction}
        data-as-of={average.as_of}
      >
        <div class="board-head">
          <p class="eyebrow">{copy.kicker}</p>
          <h2 id="avg-heading">Tracker average</h2>
          <p class="as-of">
            <span class="as-of-kicker">As of fieldwork ending</span>
            <time datetime={average.as_of}>{asOfLabel}</time>
          </p>
          <p class="muted board-meta">
            {pollCount} polls · {average.window_days_used}-day window · half-life{" "}
            {average.parameters.half_life_days} days · {copy.frame} · not a forecast
          </p>
        </div>
        <ul class="shares" role="list">
          {PARTY_ORDER.map((p) => (
            <li style={`--party-colour:${partyColour(p.colourSlug)}`}>
              <span class="swatch" aria-hidden="true" />
              <span class="party" title={PARTY_LABELS[p.key]}>
                {p.short}
                <span class="visually-hidden"> ({PARTY_LABELS[p.key]})</span>
              </span>
              <span class="pct mono">{fmt(average.primaries[p.key])}%</span>
              <span class="band mono muted">
                <span class="visually-hidden">95% interval </span>
                {fmt(average.intervals[p.key].low)}–{fmt(average.intervals[p.key].high)}
              </span>
            </li>
          ))}
        </ul>
        {
          other?.href && other.asOf && (
            <p class="poll-other">
              These are <strong>{copy.kicker}</strong> figures, not {copy.otherKind} figures.
              {" "}
              <a href={other.href}>
                {other.label} as of {formatDate(other.asOf)}
              </a>
            </p>
          )
        }
      </section>
    )
  ) : (
    <section class="poll-board empty" aria-labelledby="avg-heading">
      <h2 id="avg-heading">Tracker average</h2>
      <p>
        No numeric average is published right now
        {average?.note ? ` — ${average.note}` : ""}. Eligible polls are still listed below.
      </p>
    </section>
  )
}

<style>
  .poll-board.page,
  .poll-board.teaser,
  .poll-board.empty {
    margin: 1.25rem 0 1.5rem;
  }
  .poll-board.page,
  .poll-board.teaser {
    container-type: inline-size;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1rem, 2.4vw, 1.45rem);
    box-shadow: var(--shadow);
  }
  .poll-board.teaser {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .poll-board.teaser:hover {
    box-shadow: var(--shadow-lift);
    text-decoration: none;
  }

  .board-head h2 {
    margin: 0 0 0.35rem;
  }
  .as-of {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.65rem;
    margin: 0;
    line-height: 1.1;
  }
  .as-of-kicker {
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .as-of time {
    font-size: clamp(1.55rem, 1.1rem + 1.6vw, 2.15rem);
    font-weight: 690;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .teaser .as-of time {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem);
  }
  .board-meta {
    margin: 0.45rem 0 0;
    font-size: 0.88rem;
  }

  .shares {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .shares li {
    background: var(--surface);
    padding: 0.85rem 0.7rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    border-top: 3px solid var(--party-colour);
  }
  .swatch {
    display: none;
  }
  .party {
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--ink-2);
    letter-spacing: 0.01em;
  }
  .pct {
    font-size: clamp(1.45rem, 1.1rem + 1.3vw, 2rem);
    font-weight: 690;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
    color: var(--ink);
  }
  .teaser .pct {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.55rem);
  }
  .band {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .board-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin: 0.85rem 0 0;
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .more {
    color: var(--accent-ink);
    font-weight: 650;
  }
  .more::after {
    content: " →";
  }
  .poll-other {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  @container (max-width: 42rem) {
    .shares {
      grid-template-columns: 1fr;
    }
    .shares li {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      column-gap: 0.65rem;
      align-items: baseline;
      border-top: 0;
      border-left: 4px solid var(--party-colour);
      padding: 0.7rem 0.85rem;
    }
    .party {
      grid-column: 1;
      grid-row: 1 / span 2;
      font-size: 0.95rem;
      align-self: center;
    }
    .pct {
      grid-column: 3;
      grid-row: 1;
      text-align: right;
      font-size: 1.55rem;
    }
    .band {
      grid-column: 3;
      grid-row: 2;
      text-align: right;
    }
    .teaser .shares li {
      grid-template-rows: auto;
    }
    .teaser .party {
      grid-row: 1;
    }
  }

  @media (max-width: 40rem) {
    .shares {
      grid-template-columns: 1fr;
    }
  }
</style>
