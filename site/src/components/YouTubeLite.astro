---
/**
 * Click-to-load YouTube embed. No third-party script or iframe until the
 * visitor chooses to play — keeps the default page free of YouTube cookies.
 */
import { embedUrl, thumbUrl, watchUrl } from "../lib/videos.mjs";
import { SOCIAL } from "../lib/site.mjs";

const {
  id,
  title,
  blurb = null,
  /** Optional local poster path under /images/… — falls back to YT thumbnail */
  poster = null,
} = Astro.props;

const watch = watchUrl(id);
const embed = embedUrl(id);
const thumb = poster || thumbUrl(id);
const thumbFallback = poster || `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const uid = `yt-${id}`;
---

<figure class="yt-lite" data-yt-lite>
  <div class="yt-frame" id={uid}>
    <button
      type="button"
      class="yt-play"
      data-yt-load
      data-yt-id={id}
      data-yt-title={title}
      data-yt-embed={embed}
      aria-label={`Load and play video: ${title}`}
    >
      <img
        class="yt-poster"
        src={thumb}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        data-fallback={thumbFallback}
        onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}else{this.onerror=null}"
      />
      <span class="yt-play-badge" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48">
          <path
            class="yt-play-bg"
            d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
          ></path>
          <path class="yt-play-tri" d="M45 24 27 14v20"></path>
        </svg>
        <span class="yt-play-label">Play video</span>
      </span>
    </button>
  </div>
  <figcaption>
    <strong class="yt-cap-title">{title}</strong>
    {blurb && <span class="yt-cap-blurb">{blurb}</span>}
    <span class="yt-cap-meta muted">
      Opens YouTube only after you press play (youtube-nocookie.com).
      {" "}
      <a href={watch} rel="noopener">Watch on YouTube</a>
      {" · "}
      <a href={SOCIAL.youtube} rel="noopener">Channel</a>
    </span>
  </figcaption>
</figure>

<script>
  function loadYouTube(btn) {
    const frame = btn.closest(".yt-frame");
    if (!frame || frame.dataset.loaded === "1") return;
    const embed = btn.getAttribute("data-yt-embed");
    const title = btn.getAttribute("data-yt-title") || "YouTube video";
    if (!embed) return;
    const iframe = document.createElement("iframe");
    iframe.src = embed;
    iframe.title = title;
    iframe.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.allowFullscreen = true;
    iframe.loading = "lazy";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    // Inline styles: Astro scoped CSS does not apply to JS-created nodes.
    iframe.setAttribute(
      "style",
      "position:absolute;inset:0;width:100%;height:100%;max-width:none;border:0;display:block"
    );
    frame.dataset.loaded = "1";
    frame.replaceChildren(iframe);
  }

  document.addEventListener("click", (e) => {
    const btn = e.target.closest?.("[data-yt-load]");
    if (btn) loadYouTube(btn);
  });
</script>

<style>
  .yt-lite {
    margin: 1.25rem 0 1.75rem;
    /* Fill the content column (wrap-narrow is ~40rem; full wrap can be wider) */
    width: 100%;
    max-width: 100%;
  }
  .yt-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface-2, #122744);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* :global so a JS-injected iframe still matches after play */
  .yt-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    border: 0;
    display: block;
  }
  /* Absolute fill — global img { height: auto } would otherwise shrink the poster */
  .yt-play {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: #0b1f3a;
  }
  .yt-poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center;
  }
  .yt-play-badge {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: color-mix(in srgb, #0b1f3a 28%, transparent);
    transition: background 0.15s ease;
  }
  .yt-play:hover .yt-play-badge,
  .yt-play:focus-visible .yt-play-badge {
    background: color-mix(in srgb, #0b1f3a 12%, transparent);
  }
  .yt-play-bg {
    fill: #0b1f3a;
    fill-opacity: 0.85;
  }
  .yt-play:hover .yt-play-bg {
    fill: #c9a227;
    fill-opacity: 1;
  }
  .yt-play-tri {
    fill: #f7f1e6;
  }
  .yt-play-label {
    font-size: 0.85rem;
    font-weight: 650;
    color: #f7f1e6;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .yt-cap-title {
    color: var(--ink);
    font-size: 1rem;
  }
  .yt-cap-blurb {
    color: var(--ink-2);
  }
  .yt-cap-meta {
    font-size: 0.82rem;
  }
  .yt-cap-meta a {
    font-weight: 560;
  }
</style>
