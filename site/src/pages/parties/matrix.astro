---
import Base from "../../layouts/Base.astro";
import PolicyMatrix from "../../components/PolicyMatrix.astro";
import { matrixFor } from "../../../../scripts/lib/policies.mjs";
import { SITE } from "../../lib/site.mjs";

const matrix = matrixFor("vic2026");

const schema = {
  "@type": "WebPage",
  name: "Policy comparison matrix — Victorian state election 2026",
  description:
    "Side-by-side, sourced party positions on key issues for the 2026 Victorian state election. No ratings — quotes and costings only.",
  url: `${SITE.url}/parties/matrix`,
  isPartOf: { "@id": `${SITE.url}/#website` },
};
---

<Base
  title="Policy matrix"
  description="Compare Greens, Labor, Liberal, Nationals and One Nation positions on Victorian election issues — sourced quotes and taxpayer-cost chips only, no star ratings."
  schema={schema}
>
  <div class="wrap wrap-wide section">
    <header class="page-head">
      <p class="eyebrow">Victoria 2026</p>
      <h1>Policy comparison</h1>
      <p class="lede">
        An evidence-first matrix of party positions. Claims appear only with a dated
        public source. There are no star ratings, scorecards or editorial rankings —
        just what parties have said, and how any cost is labelled.
      </p>
      <p class="btn-row">
        <a class="btn btn-ghost btn-sm" href="/parties/issues">Jurisdiction guide</a>
        <a class="btn btn-ghost btn-sm" href="/parties">All parties</a>
        <a class="btn btn-ghost btn-sm" href="/methodology#policy-matrix">How we record positions</a>
        <a class="btn btn-ghost btn-sm" href="/data/vic2026/policies.json">policies.json</a>
        <a class="btn btn-ghost btn-sm" href="/data">All open data</a>
      </p>
    </header>

    <PolicyMatrix matrix={matrix} />
  </div>
</Base>

<style>
  /* Wider canvas for the five-column matrix without fighting global .wrap */
  .wrap-wide {
    max-width: min(92rem, 100%);
  }

  .page-head {
    max-width: 48rem;
  }
</style>
