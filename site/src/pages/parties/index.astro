---
import Base from "../../layouts/Base.astro";
import { loadElection, coverageFor, COVERAGE_CAVEAT } from "../../../../scripts/lib/data.mjs";
import { partyColour } from "../../lib/site.mjs";

const data = loadElection("vic2026");
const coverage = coverageFor(data);
const unregistered = coverage.filter((c) => data.partyBySlug.get(c.party)?.registered === false);
---

<Base
  title="Parties"
  description="Candidate coverage for every party contesting the 2026 Victorian state election — registered and unregistered — plus independents."
>
  <div class="wrap section">
    <p class="eyebrow">Victoria 2026</p>
    <h1>Parties</h1>
    <p class="lede">
      Every party on the Victorian Electoral Commission's register, plus any unregistered
      party with publicly announced candidates, all given identical treatment. Ordered by
      seats currently held in the Parliament of Victoria — an objective fact about the
      sitting parliament, not a ranking by prominence. Independents are grouped for
      convenience; they are not a party.
    </p>

    <div class="notice" role="note">
      <strong>Coverage is a count of our records, not of the ballot paper.</strong>{" "}
      {COVERAGE_CAVEAT}
    </div>

    {unregistered.length > 0 && (
      <div class="notice unreg-notice" role="note">
        <strong>{unregistered.length} of these are not on the VEC register.</strong>{" "}
        We list them because they have publicly announced candidates, but a party that
        is not registered when nominations close has no party name printed beside its
        candidates on the ballot — those candidates appear ungrouped. Registration
        status is shown on each party's page.
      </div>
    )}

    <ul class="party-grid" role="list">
      {
        coverage.map((c) => (
          <li>
            <a class="card p-card" href={`/parties/${c.party}`} style={`--party-colour:${partyColour(c.party)}`}>
              <span class="p-bar" aria-hidden="true" />
              <h2>{c.short_name}</h2>
              <p class="p-full muted">{c.name}</p>
              {data.partyBySlug.get(c.party)?.registered === false && (
                <p class="unreg">Not on the VEC register</p>
              )}

              <p class="p-seats">
                <span class="p-seats-n">{c.current.total}</span>
                <span class="muted">
                  {c.current.total === 1 ? "seat" : "seats"} held now
                  {c.current.total > 0 && (
                    <> ({c.current.assembly} Assembly, {c.current.council} Council)</>
                  )}
                </span>
              </p>

              <p class="p-count">
                <strong>{c.assembly_seats_covered}</strong>
                <span class="muted"> / {c.assembly_seats_total} districts covered for 2026</span>
              </p>
              <span class="p-track" aria-hidden="true">
                <span class="p-fill" style={`width:${c.pct}%`} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .notice {
    margin: 1.5rem 0 2rem;
    max-width: 58rem;
  }
  .party-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .p-card {
    display: block;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.15s ease;
  }
  .p-card:hover {
    border-color: var(--party-colour);
  }
  .p-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--party-colour);
  }
  .p-card h2 {
    font-size: 1.05rem;
    margin: 0 0 0.15rem;
  }
  .p-full {
    font-size: 0.8rem;
    margin: 0 0 0.5rem;
  }
  .unreg {
    margin: 0 0 0.7rem;
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--st-announced);
  }
  .unreg-notice {
    border-left-color: var(--st-announced);
  }
  .p-seats {
    margin: 0 0 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.82rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .p-seats-n {
    font-size: 1.05rem;
    font-weight: 680;
    font-variant-numeric: tabular-nums;
  }
  .p-count {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }
  .p-count strong {
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
  }
  .p-track {
    display: block;
    height: 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    overflow: hidden;
  }
  .p-fill {
    display: block;
    height: 100%;
    background: var(--party-colour);
  }
  @media (prefers-reduced-motion: reduce) {
    .p-card {
      transition: none;
    }
  }
</style>
