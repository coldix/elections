---
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/site.mjs";
import { loadPolls, computePollAverage } from "../../../../scripts/lib/polls.mjs";
import { buildMultiPartyForecast, loadVicInputs, IN_DOUBT_PP, LEANING_PP, PARTY_LABEL } from "../../../../scripts/lib/forecast.mjs";
import { renderResults, SLIDERS } from "../../lib/forecast-view.mjs";
import { DEFAULT_PARAMS } from "../../../../scripts/lib/forecast.mjs";
import buildMeta from "../../generated/build-meta.json";

const average = computePollAverage(loadPolls("vic2026"));
const { results, districts } = await loadVicInputs();
const mp = average.status === "ok" ? buildMultiPartyForecast(average.primaries, results, districts) : null;
const fc = mp ? mp.twoParty : null;
// Slim seat data bundled for the in-browser model (same fields the module reads).
const clientData = mp ? {
  average: average.primaries,
  districts: districts.map((d) => ({ slug: d.slug, name: d.name })),
  results: {
    statewide: results.statewide,
    districts: results.districts.map((d) => ({ slug: d.slug, formal: d.formal, primaries: d.primaries.map((x) => ({ party: x.party, pct: x.pct })), two_candidate_preferred: d.two_candidate_preferred ? { winner: { party: d.two_candidate_preferred.winner.party } } : null, two_party_preferred: d.two_party_preferred ? { winner: { party: d.two_party_preferred.winner.party, pct: d.two_party_preferred.winner.pct }, runner_up: { party: d.two_party_preferred.runner_up.party, pct: d.two_party_preferred.runner_up.pct } } : null })),
  },
} : null;
const ORDER = { lnp: 0, onp: 1, alp: 2, grn: 3 };
const seats = mp ? [...mp.seats].sort((a, b) => {
  const ka = a.status === "modelled" ? ORDER[a.leader] * 100 - a.margin_central * (a.leader === "lnp" ? 1 : -1) : 999;
  const kb = b.status === "modelled" ? ORDER[b.leader] * 100 - b.margin_central * (b.leader === "lnp" ? 1 : -1) : 999;
  return ka - kb;
}) : [];
const onpTopTwo = mp ? mp.seats.filter((s) => s.finalists?.includes("onp")).length : 0;
const PARTIES = [["labor", "Labor"], ["coalition", "Coalition"], ["greens", "Greens"], ["one-nation", "One Nation"]];
const CLS = { alp: "labor", lnp: "coalition", grn: "greens", onp: "onp" };
const updated = buildMeta?.built_at_utc ? buildMeta.built_at_utc.slice(0, 10) : null;
const RATING = { firm: "Firm", leaning: "Leaning", doubt: "In doubt" };
const SIDE = { labor: "Labor ahead", coalition: "Coalition ahead", tied: "Tied" };
---

<Base
  title="Forecast — our model, not a prediction"
  description="This site's own seat model for the Victorian election: uniform swing from the latest poll average with three preference scenarios. Kept separate from the sourced poll data."
  breadcrumbs={[{ name: "Forecast", href: "/forecast" }]}
>
  <div class="forecast-zone">
    <div class="forecast-banner" role="note">
      <strong>Forecast: our model, not a prediction of the result</strong>
      <span>Everything on this page is our own calculation. It is not sourced data and it is not
      part of the poll ledger. <a href="/forecast/methodology">How the model works</a></span>
    </div>
    <div class="wrap section">
      <p class="eyebrow">Forecast section · model output</p>
      <h1>Victorian Assembly seat model</h1>
      <p class="lede">
        What the current poll average would mean for each of the 88 districts if every party's primary vote
        moved by the same amount in every seat, including One Nation and the Greens, under three assumptions about preferences.
      </p>
      <p class="fc-updated">
        Last updated {updated ? formatDate(updated) : "—"} · poll average as of {fc ? formatDate(average.as_of) : "—"}
      </p>

      {!fc && <p class="empty">The poll average is not available, so the model has nothing to run on.</p>}

      {fc && (
        <>
          <section class="fc-assume" aria-labelledby="assume-h">
            <h2 id="assume-h">Assumptions: try your own</h2>
            <p class="small">The results below use our default assumptions. Move a slider to see <strong>your scenario</strong>: the counts, One Nation's closest seats and the seat map update in your browser. Nothing is saved or sent. Needs JavaScript; without it you see our defaults.</p>
            <form id="fc-form" class="fc-sliders" hidden>
              {SLIDERS.map((sl) => (
                <div class="sl">
                  <label for={`sl-${sl.key}`}>{sl.label}</label>
                  <input type="range" id={`sl-${sl.key}`} name={sl.key} min={sl.min} max={sl.max} step={sl.step} value={DEFAULT_PARAMS[sl.key]} aria-describedby={`out-${sl.key}`} />
                  <output id={`out-${sl.key}`} for={`sl-${sl.key}`}>{sl.fmt(DEFAULT_PARAMS[sl.key])}</output>
                  <span class="def small muted">default {sl.fmt(DEFAULT_PARAMS[sl.key])}</span>
                </div>
              ))}
              <p><button type="reset" id="fc-reset">Reset to defaults</button></p>
            </form>
            <p id="fc-status" class="fc-status" aria-live="polite"></p>
          </section>

          <div id="fc-results" set:html={renderResults(mp)} />
          <script type="application/json" id="fc-data" set:html={JSON.stringify(clientData)} />

          <section>
            <h2>Seats the model does not rate</h2>
            <ul>
              {mp.seats.filter((s) => s.status !== "modelled").map((s) => <li><strong>{s.name}</strong> — {s.reason}.</li>)}
            </ul>
            <p class="small muted">"Others" lumps every independent and minor-party candidate together, so it cannot be treated as one candidate. 2022 Greens seats (Brunswick, Melbourne, Prahran, Richmond) are modelled in the primary layer above.</p>
          </section>

          <section>
            <h2>Labor v Coalition layer</h2>
            <p class="small muted">The original two-party model, kept for comparison: uniform swing on each district's 2022 Labor v Coalition count. It assumes every seat ends Labor v Coalition.</p>
            <table class="fc-table">
              <thead><tr><th scope="col"></th><th scope="col">Firm</th><th scope="col">Leaning</th><th scope="col">In doubt</th></tr></thead>
              <tbody>
                <tr><th scope="row">Labor ahead</th><td>{fc.summary.labor.firm}</td><td>{fc.summary.labor.leaning}</td><td>{fc.summary.labor.doubt}</td></tr>
                <tr><th scope="row">Coalition ahead</th><td>{fc.summary.coalition.firm}</td><td>{fc.summary.coalition.leaning}</td><td>{fc.summary.coalition.doubt}</td></tr>
              </tbody>
            </table>
            <p class="small muted">Range across scenarios: Labor ahead in {fc.range.labor_ahead[0]}–{fc.range.labor_ahead[1]}, Coalition ahead in {fc.range.coalition_ahead[0]}–{fc.range.coalition_ahead[1]}; {fc.not_modelled} seats have no 2022 Labor v Coalition count.</p>
          </section>

          <section>
            <h2>Other contests</h2>
            <p class="empty">
              NSW (13 March 2027): not modelled yet. The ledger does not hold 2023 district results, which
              the model needs. Queensland, South Australia, Western Australia, Tasmania and federal: not modelled.
            </p>
          </section>
        </>
      )}
    </div>
  </div>
</Base>

<script>
  import { buildMultiPartyForecast, DEFAULT_PARAMS } from "../../../../scripts/lib/forecast.mjs";
  import { renderResults } from "../../lib/forecast-view.mjs";
  const dataEl = document.getElementById("fc-data");
  const form = document.getElementById("fc-form") as HTMLFormElement | null;
  const out = document.getElementById("fc-results");
  const status = document.getElementById("fc-status");
  if (dataEl && form && out) {
    const data = JSON.parse(dataEl.textContent || "{}");
    form.hidden = false;
    const read = () => Object.fromEntries([...form.querySelectorAll("input[type=range]")].map((i) => [(i as HTMLInputElement).name, Number((i as HTMLInputElement).value)]));
    const isDefault = (p) => Object.keys(DEFAULT_PARAMS).every((k) => Math.abs(p[k] - DEFAULT_PARAMS[k]) < 1e-9);
    const run = () => {
      const p = read();
      for (const i of form.querySelectorAll("input[type=range]")) {
        const inp = i as HTMLInputElement;
        const o = document.getElementById(`out-${inp.name}`);
        const v = Number(inp.value);
        if (o) o.textContent = inp.name === "onpShift" ? `${v > 0 ? "+" : ""}${v} pts` : inp.name === "onpBaseline" ? `${v}%` : `${Math.round(v * 100)}%`;
      }
      const mp = buildMultiPartyForecast(data.average, data.results, data.districts, p);
      const def = isDefault(p);
      out.innerHTML = renderResults(mp, { label: def ? "Our default assumptions" : "Your scenario — your assumptions, not ours" });
      out.classList.toggle("yours", !def);
      if (status) status.textContent = def ? "" : "Showing your scenario. Use Reset to return to our defaults.";
    };
    form.addEventListener("input", run);
    form.addEventListener("reset", () => setTimeout(run, 0));
  }
</script>

<style is:global>
  .fc-sliders[hidden] { display: none; }
  .fc-assume { margin: 1.5rem 0 0.5rem; }
  .fc-sliders { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 0.8rem 1.5rem; }
  .sl { display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 0.6rem; align-items: center; }
  .sl label { grid-column: 1 / -1; font-weight: 600; font-size: 0.9rem; }
  .sl input[type=range] { width: 100%; min-height: 2rem; accent-color: var(--st-announced); }
  .sl output { font-variant-numeric: tabular-nums; font-weight: 700; min-width: 4.5rem; text-align: right; }
  .sl .def { grid-column: 1 / -1; }
  .fc-sliders button { padding: 0.5rem 1rem; font: inherit; cursor: pointer; }
  .fc-status { font-weight: 600; color: var(--st-announced); min-height: 1.2em; }
  .fc-label { margin: 1rem 0 0; padding: 0.5rem 0.75rem; background: var(--paper, transparent); border-left: 4px solid var(--rule-strong); font-size: 0.85rem; }
  #fc-results.yours .fc-label { border-left-color: var(--st-announced); background: var(--st-announced-bg); color: var(--st-announced); }
  .forecast-zone { background: repeating-linear-gradient(135deg, transparent 0 22px, var(--accent-wash) 22px 24px); border-top: 4px solid var(--st-announced); }
  .forecast-banner { background: var(--st-announced-bg); color: var(--st-announced); padding: 0.9rem clamp(1rem, 4vw, 2rem); display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; border-bottom: 1px solid var(--rule-strong); }
  .forecast-banner strong { font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .forecast-banner a { color: inherit; text-decoration: underline; }
  .fc-updated { color: var(--ink-2); font-weight: 600; }
  .fc-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .fc-summary h2 { font-size: 1.1rem; margin-top: 0; }
  .fc-table { border-collapse: collapse; font-variant-numeric: tabular-nums; width: 100%; }
  .fc-table th, .fc-table td { text-align: left; padding: 0.3rem 0.6rem 0.3rem 0; border-bottom: 1px solid var(--rule); }
  .legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.88rem; }
  .legend li { display: flex; align-items: center; gap: 0.35rem; }
  .sw { width: 1rem; height: 1rem; border-radius: 3px; display: inline-block; border: 1px solid var(--rule-strong); }
  .seatmap { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 4px; }
  .tile a { display: block; padding: 0.45rem 0.35rem; font-size: 0.72rem; line-height: 1.15; border-radius: 4px; text-decoration: none; color: #111; min-height: 2.6rem; }
  .labor-firm, .tile.labor-firm a { background: #c8434a; }
  .tile.labor-firm a { color: #fff; }
  .labor-leaning, .tile.labor-leaning a { background: #eba3a6; }
  .coalition-firm, .tile.coalition-firm a { background: #2f5d9e; }
  .tile.coalition-firm a { color: #fff; }
  .coalition-leaning, .tile.coalition-leaning a { background: #a5bde0; }
  .doubt, .tile.doubt a { background: repeating-linear-gradient(45deg, #e9e3d3 0 6px, #d6cdb6 6px 12px); }
  .greens-firm, .tile.greens-firm a, .tile.greens-leaning a { background: #3a8a4a; }
  .tile.greens-firm a { color: #fff; }
  .onp-firm, .tile.onp-firm a, .tile.onp-leaning a { background: #e08a1e; }
  .indc, .tile.indc a { background: repeating-linear-gradient(-45deg, #cfe3d2 0 6px, #f0f0f0 6px 12px); color: #333; }
  .fin { display: block; font-size: 0.62rem; opacity: 0.85; margin-top: 2px; }
  .none, .tile.none a { background: #ddd; color: #555; }
  .empty { color: var(--ink-3); font-style: italic; }
  .small { font-size: 0.85rem; }
  .muted { color: var(--ink-3); }
</style>
