---
import Base from "../../layouts/Base.astro";
import SourceLink from "../../components/SourceLink.astro";
import { SITE } from "../../lib/site.mjs";
import {
  buildPollFeed,
  FEED_LEDGERS,
  partyLabel,
  loadUpperHouseProjections,
} from "../../../../scripts/lib/poll-feed.mjs";

const feed = buildPollFeed();
const upper = loadUpperHouseProjections();
const KEYS = ["alp", "lnp", "onp", "grn", "others"];
const counts = Object.fromEntries(
  FEED_LEDGERS.map((l) => [l.jurisdiction, feed.filter((e) => e.jurisdiction === l.jurisdiction).length])
);
const sign = (d) => (d > 0 ? `+${d}` : d === 0 ? "0" : `${d}`);
const upperByJ = (j) => upper.projections.filter((p) => p.jurisdiction === j);
---

<Base
  title="Poll tracker — every published poll, dated and sourced"
  description="A dated feed of published Australian voting-intention polls (NSW, Victoria, Queensland, SA, WA, Tasmania and federal): pollster, sample size, fieldwork dates, change since that pollster's last poll, margin-of-error flag and source links."
  breadcrumbs={[{ name: "Poll tracker", href: "/poll-tracker" }]}
>
  <div class="wrap section feed-page">
    <p class="eyebrow">Sourced data · one entry per published poll</p>
    <h1>Poll tracker</h1>
    <p class="lede">
      Every published statewide or national voting-intention poll in the ledger, newest first.
      Each entry shows who ran it, how many people were asked, when, and how the figures moved
      since that pollster's previous poll. The bullets are generated from the numbers only.
    </p>
    <p class="feed-links">
      <a href="/poll-tracker/voter-groups">Voter-group explorer</a> ·
      <a href="#upper-house">Upper house projections (pollsters' own)</a> ·
      <a href="/forecast">Forecast section (our model, kept separate)</a>
    </p>

    <div class="feed-filter">
      <label for="feed-j">Show</label>
      <select id="feed-j">
        <option value="all">All contests ({feed.length})</option>
        {FEED_LEDGERS.map((l) => (
          <option value={l.jurisdiction}>{l.election} ({counts[l.jurisdiction]})</option>
        ))}
      </select>
    </div>

    <div class="notice" role="note">
      <strong>Margin of error.</strong> When a pollster states its margin of error we use it;
      otherwise we estimate it from the sample size (95% level, design effect 1.3) and say so.
      A move <em>inside</em> the margin may be sampling noise, not a real shift.
    </div>

    <ol class="feed" id="feed">
      {feed.map((e) => (
        <li class="feed-item card" data-j={e.jurisdiction}>
          <header class="feed-head">
            <span class="feed-j">{e.jurisdiction_label}</span>
            <h2 class="feed-title">{e.pollster}</h2>
            <span class="feed-dates"><time datetime={e.fieldwork_end}>{e.fieldwork_label}</time></span>
          </header>
          <p class="feed-meta">
            {e.election} · n = {e.sample_size.toLocaleString("en-AU")} · {e.mode} ·
            margin of error ±{e.moe.value}{e.moe.stated ? " (stated)" : " (estimated)"}
            {!e.eligible_for_average && <> · <span class="pill-muted">not in average</span></>}
          </p>
          {e.within_moe === true && (
            <p class="moe-flag moe-in">All changes since this pollster's last poll are inside the margin of error.</p>
          )}
          {e.within_moe === false && (
            <p class="moe-flag moe-out">At least one change is larger than the margin of error.</p>
          )}
          {e.within_moe === null && <p class="moe-flag moe-na">No earlier poll from this pollster to compare.</p>}
          <table class="feed-table">
            <thead>
              <tr><th scope="col">Party</th><th scope="col">Primary</th><th scope="col">Change</th></tr>
            </thead>
            <tbody>
              {KEYS.map((k) => (
                <tr>
                  <th scope="row">{partyLabel(k, e.jurisdiction)}</th>
                  <td>{e.primaries[k]}%</td>
                  <td>{e.change ? sign(e.change[k]) : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <ul class="feed-bullets">
            {e.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <p class="feed-sources">
            Source{e.sources.length > 1 ? "s" : ""}:{" "}
            {e.sources.map((s, i) => (
              <>{i > 0 && " · "}<SourceLink source={s} /></>
            ))}
          </p>
        </li>
      ))}
    </ol>

    <section id="upper-house" class="upper">
      <h2>Upper house projections — the pollsters' own</h2>
      <p class="notice" role="note">
        These seat numbers are <strong>each pollster's own projection</strong>, copied as published.
        They are not this site's estimate and are not part of our Forecast section.
      </p>
      {FEED_LEDGERS.filter((l) => l.jurisdiction !== "federal").map((l) => (
        <div class="upper-j">
          <h3>{l.label}</h3>
          {upperByJ(l.jurisdiction).length === 0 ? (
            <p class="empty">No published pollster projection for this upper house in the ledger.</p>
          ) : (
            upperByJ(l.jurisdiction).map((p) => (
              <div class="card upper-card">
                <p class="upper-label">Pollster's projection — {p.pollster}, {p.fieldwork} (n = {p.sample_size.toLocaleString("en-AU")})</p>
                <p class="muted">{p.chamber} · {p.seats_total} seats</p>
                <ul class="upper-seats">
                  {p.seats.map((s) => <li><span>{s.label}</span><strong>{s.seats}</strong></li>)}
                </ul>
                {p.note && <p class="muted small">{p.note}</p>}
                <p class="small">Source: <SourceLink source={p.source} /></p>
              </div>
            ))
          )}
        </div>
      ))}
    </section>
  </div>
</Base>

<script is:inline>
  (function () {
    var sel = document.getElementById("feed-j");
    if (!sel) return;
    var items = document.querySelectorAll("#feed .feed-item");
    function apply() {
      var v = sel.value;
      items.forEach(function (el) { el.hidden = !(v === "all" || el.getAttribute("data-j") === v); });
    }
    var q = new URLSearchParams(location.search).get("j");
    if (q) sel.value = q;
    sel.addEventListener("change", apply);
    apply();
  })();
</script>

<style>
  .feed-links { margin: 0.4rem 0 1.2rem; }
  .feed-filter { display: flex; gap: 0.6rem; align-items: center; margin: 1rem 0; }
  .feed-filter select { padding: 0.4rem 0.6rem; border-radius: var(--radius-sm); border: 1px solid var(--rule-strong); background: var(--surface); color: var(--ink); }
  .feed { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .feed-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; }
  .feed-j { font-size: 0.75rem; font-weight: 660; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-ink); background: var(--accent-wash); padding: 0.15rem 0.5rem; border-radius: 999px; }
  .feed-title { font-size: 1.2rem; margin: 0; }
  .feed-dates { color: var(--ink-2); margin-left: auto; }
  .feed-meta { color: var(--ink-2); font-size: 0.92rem; margin: 0.4rem 0; }
  .moe-flag { font-size: 0.88rem; padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); display: inline-block; margin: 0.2rem 0 0.6rem; }
  .moe-in { background: var(--st-nominated-bg); color: var(--st-nominated); }
  .moe-out { background: var(--st-announced-bg); color: var(--st-announced); }
  .moe-na { background: var(--st-none); color: var(--ink-2); }
  .feed-table { border-collapse: collapse; font-variant-numeric: tabular-nums; margin: 0.3rem 0 0.6rem; }
  .feed-table th, .feed-table td { padding: 0.2rem 0.9rem 0.2rem 0; text-align: left; border-bottom: 1px solid var(--rule); }
  .feed-table thead th { font-size: 0.78rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.05em; }
  .feed-bullets { margin: 0.4rem 0; padding-left: 1.2rem; }
  .feed-bullets li { margin: 0.2rem 0; }
  .feed-sources { font-size: 0.86rem; color: var(--ink-2); margin: 0.4rem 0 0; }
  .pill-muted { font-size: 0.8rem; background: var(--st-none); padding: 0.05rem 0.4rem; border-radius: 999px; }
  .upper { margin-top: 3rem; }
  .upper-j { margin: 1.2rem 0; }
  .upper-card { margin: 0.5rem 0; }
  .upper-label { font-weight: 640; margin: 0; }
  .upper-seats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.3rem 1rem; }
  .upper-seats li { display: flex; justify-content: space-between; border-bottom: 1px solid var(--rule); padding: 0.2rem 0; }
  .empty { color: var(--ink-3); font-style: italic; }
  .small { font-size: 0.85rem; }
  .muted { color: var(--ink-3); }
</style>
