---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site.mjs";
import { COVERAGE_CAVEAT } from "../../../scripts/lib/data.mjs";

const statuses = [
  ["Announced", "The person or media report an intention to stand. Party endorsement is not confirmed.", "A public statement by the person or party, or a named news report."],
  ["Endorsed", "The party has preselected or endorsed the person for that seat.", "A party announcement, or a news report citing the party."],
  ["Formally nominated", "A nomination has been accepted by the electoral commission.", "The commission's nominations list."],
  ["Withdrawn", "The candidacy ended, before or after nomination.", "A statement or news report. Any published reason is recorded neutrally."],
  ["Disendorsed", "The party revoked its endorsement.", "A party statement or news report. Wording stays with the sourced fact."],
  ["Elected", "Declared elected.", "The commission's declaration."],
  ["Defeated", "Contested and not elected.", "The commission's results."],
];

const electionDateStatuses = [
  ["Confirmed", "An electoral commission or other authoritative body has published the polling date."],
  ["Fixed-cycle date", "Calculated directly from a statutory recurring rule. Exceptional postponement may still be possible."],
  ["Legal window", "No polling day has been announced, so the normal or lawful election range is shown."],
  ["Not fixed", "The term or expected year is known, but an earlier election may be called."],
  ["Periodic election", "A recurring partial parliamentary election held separately from the jurisdiction's general election."],
];
---

<Base
  title="Methodology"
  description="How the Australian Election Tracker defines candidate statuses, sources, external links, election-date certainty, coverage, corrections and neutrality."
>
  <div class="wrap wrap-narrow section">
    <p class="eyebrow">How this works</p>
    <h1>Methodology</h1>
    <p class="lede">
      One set of published rules, applied identically to every party and every independent.
      A candidacy record without a source fails the automated checks and cannot be published.
    </p>

    <h2>Candidate statuses</h2>
    <p>
      A candidacy holds one current status. Every previous status remains in its history,
      with the date and source that supported it. Rumour and speculation are not recorded.
    </p>

    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Status</th>
            <th scope="col">Meaning</th>
            <th scope="col">Minimum evidence</th>
          </tr>
        </thead>
        <tbody>
          {statuses.map(([name, meaning, evidence]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{meaning}</td>
              <td class="muted">{evidence}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="sourcing">Sourcing rules</h2>
    <ul>
      <li>Every status entry records a URL, publisher, title, publication date and access date.</li>
      <li>Primary sources such as commissions, parliaments, parties and candidates are preferred.</li>
      <li>Secondary sources are named by outlet, never with vague wording such as “reports say”.</li>
      <li>Paywalled sources may be used when publicly citable; an archive link is added where possible.</li>
      <li>Social-media posts count only from a confidently identified official party or candidate account.</li>
    </ul>

    <h2 id="candidate-links">Candidate links</h2>
    <p>
      Candidate cards may include a small number of external links for identification and
      further reading. Their inclusion is not an endorsement.
    </p>
    <ol>
      <li>Official candidate, campaign, parliamentary or party profile.</li>
      <li>One principal public political social-media account, where it can be confidently identified.</li>
      <li>Wikipedia only when no better official profile is available, clearly labelled as an external reference.</li>
    </ol>
    <p>
      We do not add several social accounts merely to increase exposure. A personal account
      is linked only when the candidate publicly uses it for political campaigning. Dead,
      renamed or ambiguous accounts are removed rather than guessed.
    </p>

    <div class="notice" role="note">
      <strong>No people pages yet.</strong> The site does not currently publish
      <code>/people</code> pages or maintain a separate people dataset. A future design has
      been documented for consideration, but no route or profile system has been approved.
      Public information remains attached to the relevant election and candidate record.
    </div>

    <h2 id="election-dates">Election calendar and date certainty</h2>
    <p>
      The <a href="/elections">upcoming elections calendar</a> covers the next general
      parliamentary election for the Commonwealth and every state and territory. It does
      not present all future dates with the same degree of certainty.
    </p>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Label</th>
            <th scope="col">Meaning</th>
          </tr>
        </thead>
        <tbody>
          {electionDateStatuses.map(([name, meaning]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul>
      <li>Electoral commissions, parliaments and current legislation are preferred.</li>
      <li>Every calendar entry carries a source and verification date.</li>
      <li>A calculated statutory date is never described as announced or confirmed.</li>
      <li>Where a lawful range is more useful than speculation, the range is published.</li>
      <li>Official writs or announcements replace calculated dates while Git history preserves the change.</li>
      <li>By-elections, local government elections and referendums are excluded unless separately added.</li>
    </ul>

    <h2 id="coverage">How coverage is counted</h2>
    <p>
      A party covers a district when the ledger holds at least one individually sourced live
      candidacy for that party in that district.
    </p>
    <div class="notice" role="note">
      <strong>The limitation you should know about.</strong> {COVERAGE_CAVEAT}
    </div>
    <p>
      A district with no recorded candidate means we have not verified one, not that nobody
      is standing. The Victorian Electoral Commission remains authoritative for the final ballot.
    </p>

    <h2 id="optional-fields">Optional public context</h2>
    <p>
      Candidate records may include a short public occupation or political role and a
      one-line career background. These fields are optional and must be checkable against a
      campaign biography, party page or news profile.
    </p>
    <p>
      Family details, private addresses, personal contact information, health information and
      unrelated private material are outside scope.
    </p>

    <h2 id="corrections">Corrections</h2>
    <p>
      Errors are corrected by a new commit. History is never rewritten. A genuine change of
      candidacy is recorded as status history rather than disguised as a correction or deletion.
    </p>
    <p><a class="btn" href={SITE.issues}>Submit a correction</a></p>

    <h2 id="neutrality">Neutrality</h2>
    <ul>
      <li>Every registered party and independent receives identical structure and display treatment.</li>
      <li>Party listings use current parliamentary seats, then alphabetical order.</li>
      <li>Listings are never ordered by campaign activity, polling or editorial judgement.</li>
      <li>No payment, sponsorship or advertising can affect coverage, ordering or verification.</li>
    </ul>

    <h2 id="polls">Polls and policy products</h2>
    <p>
      Poll averages and policy comparisons use separate published rules. They do not change
      candidate ordering and are not voting recommendations.
    </p>
    <p>
      See the <a href="/elections/vic/2026/polls">poll average</a>,
      <a href="/elections/vic/2026/parties/issues">jurisdiction guide</a> and
      <a href="/elections/vic/2026/parties/matrix">policy matrix</a>.
    </p>

    <p class="foot muted">
      These public rules mirror <code>docs/methodology.md</code> in the
      <a href={SITE.repo}>public repository</a>. The unapproved people-page design is kept
      separately as a proposal so it cannot be mistaken for a current product commitment.
    </p>
  </div>
</Base>

<style>
  h2 {
    margin-top: 2.5rem;
  }
  ul,
  ol {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    color: var(--ink-2);
  }
  .notice {
    margin: 1.25rem 0;
  }
  .foot {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
</style>
