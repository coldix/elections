---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site.mjs";

// Stripe Payment Links (no server code: this site is an assets-only Worker,
// see docs/decisions.md ADR-2). Set at build time in Workers Builds env vars.
// Use TEST-mode links (https://buy.stripe.com/test_...) until Colin approves live.
// A button only renders when its link is set.
const env = import.meta.env;
const isStripe = (u) => typeof u === "string" && /^https:\/\/(buy|donate)\.stripe\.com\//.test(u);
const donateLink = isStripe(env.PUBLIC_STRIPE_DONATE_LINK) ? env.PUBLIC_STRIPE_DONATE_LINK : "";
const subscribeLink = isStripe(env.PUBLIC_STRIPE_SUBSCRIBE_LINK) ? env.PUBLIC_STRIPE_SUBSCRIBE_LINK : "";
const isTest = [donateLink, subscribeLink].some((u) => u.includes("/test_"));
---

<Base
  title="Support the tracker"
  description="The Australian Election Tracker is independent and non-partisan. Support it by grabbing a tee or a print from the shop."
>
  <div class="wrap wrap-narrow section">
    <p class="eyebrow">Support</p>
    <h1>Support the tracker</h1>
    <p class="lede">
      The Australian Election Tracker is independent, non-partisan and free to use, with no
      party or candidate advertising. If you find it useful, you can help keep it running by
      grabbing a tee, sticker or print from the shop.
    </p>
    <p>
      <a class="shop-btn" href="https://girl.oze.au/shop" rel="noopener">Visit the shop ↗</a>
    </p>
    <p class="muted">
      The shop features photography prints and apparel by {SITE.publisher}, printed to order by
      Australian print partners and Redbubble. Purchases don't influence our coverage.
    </p>
    {(donateLink || subscribeLink) && (
      <>
        <h2>Donate or subscribe</h2>
        <p>
          Prefer to chip in directly? Payments are handled securely by Stripe. The tracker is
          not a registered charity, so contributions are not tax deductible.
        </p>
        {isTest && <p class="muted"><strong>Test mode:</strong> no real payments are taken.</p>}
        <p class="pay-row">
          {donateLink && <a class="shop-btn" href={donateLink} rel="noopener">Donate once ↗</a>}
          {subscribeLink && <a class="shop-btn alt" href={subscribeLink} rel="noopener">Support monthly ↗</a>}
        </p>
      </>
    )}
    <h2>Sponsorship enquiries</h2>
    <p>
      Interested in sponsoring the tracker? Email
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We don't accept sponsorship from
      political parties, candidates or campaigns.
    </p>
  </div>
</Base>

<style>
  .shop-btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: 0.5rem;
    background: var(--accent-ink);
    color: var(--surface-2);
    font-weight: 620;
    text-decoration: none;
  }
  .pay-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .shop-btn.alt { background: transparent; color: var(--accent-ink); border: 1px solid var(--accent-ink); }
  .shop-btn:hover { opacity: 0.9; }
</style>
