---
import Base from "../../layouts/Base.astro";
import { loadElection, LIVE_STATUSES } from "../../../../scripts/lib/data.mjs";
import { partyColour } from "../../lib/site.mjs";

const data = loadElection("vic2026");
const districts = [...data.districts].sort((a, b) => a.name.localeCompare(b.name));
const regions = [...data.regions].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Legislative Assembly districts"
  description="All 88 Victorian Legislative Assembly districts for the 2026 state election, with sitting members and individually sourced candidate records."
>
  <div class="wrap section">
    <p class="eyebrow">Victoria 2026</p>
    <h1>Districts &amp; regions</h1>
    <p class="lede">
      The Legislative Assembly has {districts.length} single-member districts. The
      Legislative Council has {regions.length} regions electing five members each. Boundaries
      are those set at the 2021 redivision.
    </p>

    <h2 class="lh">Legislative Assembly</h2>
    <div class="table-scroll">
      <table class="data">
        <caption class="visually-hidden">Legislative Assembly districts</caption>
        <thead>
          <tr>
            <th scope="col">District</th>
            <th scope="col">Council region</th>
            <th scope="col">Sitting member</th>
            <th scope="col" class="num">Candidates recorded</th>
          </tr>
        </thead>
        <tbody>
          {
            districts.map((d) => {
              const live = d.candidates.filter((c) => LIVE_STATUSES.includes(c.status));
              const region = data.regions.find((r) => r.slug === d.region);
              const retiring = d.retirements.length > 0;
              return (
                <tr>
                  <th scope="row">
                    <a href={`/districts/${d.slug}`}>{d.name}</a>
                  </th>
                  <td class="muted">{region?.name ?? "—"}</td>
                  <td>
                    <span class="member">
                      <span
                        class="swatch"
                        style={`--party-colour:${partyColour(d.incumbent_party)}`}
                        aria-hidden="true"
                      />
                      {d.incumbent}
                    </span>
                    {retiring && <span class="pill pill-withdrawn retiring">Not recontesting</span>}
                  </td>
                  <td class="num">{live.length || "—"}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <h2 class="lh" id="council">Legislative Council regions</h2>
    <p class="muted section-note">
      Each region elects five members by proportional representation. Listed below are the
      members who <strong>currently hold</strong> each seat — including mid-term
      replacements and party changes since 2022. Sitting here does not make someone a 2026
      candidate; candidacies are tracked separately.
    </p>

    <ul class="regions" role="list">
      {
        regions.map((r) => (
          <li class="card region">
            <div class="region-head">
              <h3>{r.name}</h3>
              <span class="muted">{r.seats} members</span>
            </div>

            <ul class="members" role="list">
              {r.members.map((m) => {
                const retiring = data.retirements.some(
                  (x) => x.role === "MLC" && x.name === m.name
                );
                return (
                  <li>
                    <span
                      class="swatch"
                      style={`--party-colour:${partyColour(m.party)}`}
                      aria-hidden="true"
                    />
                    <span class="m-name">{m.name}</span>
                    <span class="muted m-party">
                      {data.partyBySlug.get(m.party)?.short_name ?? m.party}
                    </span>
                    {retiring && <span class="pill pill-withdrawn">Not recontesting</span>}
                    {m.note && (
                      <span class="m-note muted" title={m.note}>
                        ⓘ<span class="visually-hidden"> {m.note}</span>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>

            <p class="muted region-districts">
              <strong>Districts:</strong>{" "}
              {data.districts
                .filter((d) => d.region === r.slug)
                .map((d) => d.name)
                .join(", ")}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .lh {
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
  }
  .member {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .retiring {
    margin-left: 0.5rem;
  }
  .district-list {
    max-width: 34rem;
    font-size: 0.85rem;
  }
  .section-note {
    max-width: 54rem;
    margin-bottom: 1.25rem;
  }
  .regions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1rem;
  }
  .region-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .region-head h3 {
    margin: 0;
    font-size: 1.02rem;
  }
  .members {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .members li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .m-name {
    font-weight: 560;
  }
  .m-party {
    font-size: 0.85rem;
  }
  .m-note {
    cursor: help;
  }
  .region-districts {
    margin: 0.95rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
    line-height: 1.55;
  }
</style>
