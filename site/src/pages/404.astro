---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex={true}>
  <div class="wrap wrap-narrow section">
    <p class="eyebrow">404</p>
    <h1>That page isn't here</h1>
    <p class="lede">
      The link may be out of date, or the record may not exist yet. These are the useful
      starting points.
    </p>
    <p class="btn-row">
      <a class="btn" href="/">Victorian election overview</a>
      <a class="btn btn-ghost" href="/assembly">Assembly</a>
      <a class="btn btn-ghost" href="/council">Council</a>
      <a class="btn btn-ghost" href="/parties">Parties</a>
      <a class="btn btn-ghost" href="/voting">Voting</a>
      <a class="btn btn-ghost" href="/polls">Polls</a>
      <a class="btn btn-ghost" href="/data">Open data</a>
      <a class="btn btn-ghost" href="/methodology">Methodology</a>
    </p>
  </div>
</Base>
