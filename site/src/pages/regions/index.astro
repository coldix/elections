---
import Base from "../../layouts/Base.astro";
import { loadElection, LIVE_STATUSES } from "../../../../scripts/lib/data.mjs";
import { partyColour } from "../../lib/site.mjs";

const data = loadElection("vic2026");
const regions = [...data.regions].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Legislative Council regions"
  description="Victorian Legislative Council regions for the 2026 state election: sitting members and individually sourced upper-house candidates."
>
  <div class="wrap section">
    <p class="eyebrow">Victoria 2026 · Upper house</p>
    <h1>Legislative Council regions</h1>
    <p class="lede">
      Victoria’s upper house has {regions.length} regions electing five members each by
      proportional representation (40 seats total). Sitting members are who holds the seat
      <strong>now</strong>; 2026 candidacies are recorded only with an individual source.
    </p>
    <p class="muted">
      Assembly districts: <a href="/districts">/districts</a>.
    </p>

    <div class="table-scroll">
      <table class="data">
        <caption class="visually-hidden">Legislative Council regions</caption>
        <thead>
          <tr>
            <th scope="col">Region</th>
            <th scope="col" class="num">Seats</th>
            <th scope="col" class="num">Candidates recorded</th>
            <th scope="col" class="num">Districts</th>
          </tr>
        </thead>
        <tbody>
          {
            regions.map((r) => {
              const live = r.candidates.filter((c) => LIVE_STATUSES.includes(c.status));
              const districtCount = data.districts.filter((d) => d.region === r.slug).length;
              return (
                <tr>
                  <th scope="row">
                    <a href={`/regions/${r.slug}`}>{r.name}</a>
                  </th>
                  <td class="num">{r.seats}</td>
                  <td class="num">{live.length || "—"}</td>
                  <td class="num">{districtCount}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <h2 class="lh">Sitting members by region</h2>
    <p class="muted section-note">
      Mid-term replacements and party changes are included. A sitting MLC is not automatically a
      2026 candidate.
    </p>
    <ul class="regions" role="list">
      {
        regions.map((r) => (
          <li class="card region">
            <div class="region-head">
              <h3>
                <a href={`/regions/${r.slug}`}>{r.name}</a>
              </h3>
              <span class="muted">{r.seats} members</span>
            </div>
            <ul class="members" role="list">
              {r.members.map((m) => {
                const retiring = data.retirements.some(
                  (x) => x.role === "MLC" && x.name === m.name
                );
                return (
                  <li>
                    <span
                      class="swatch"
                      style={`--party-colour:${partyColour(m.party)}`}
                      aria-hidden="true"
                    />
                    <span class="m-name">{m.name}</span>
                    <span class="muted m-party">
                      {data.partyBySlug.get(m.party)?.short_name ?? m.party}
                    </span>
                    {retiring && <span class="pill pill-withdrawn">Not recontesting</span>}
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .lh {
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
  }
  .section-note {
    max-width: 54rem;
    margin-bottom: 1.25rem;
  }
  .regions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1rem;
  }
  .region-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .region-head h3 {
    margin: 0;
    font-size: 1.02rem;
  }
  .region-head a {
    color: inherit;
    text-decoration: none;
  }
  .region-head a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .members {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .members li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .m-name {
    font-weight: 560;
  }
  .m-party {
    font-size: 0.85rem;
  }
</style>
