---
import Base from "../../layouts/Base.astro";
import SourceLink from "../../components/SourceLink.astro";
import {
  loadElection,
  LIVE_STATUSES,
  STATUS_LABELS,
} from "../../../../scripts/lib/data.mjs";
import { SITE, partyColour, formatDate } from "../../lib/site.mjs";

export async function getStaticPaths() {
  const data = loadElection("vic2026");
  return data.regions.map((r) => ({ params: { slug: r.slug }, props: { slug: r.slug } }));
}

const data = loadElection("vic2026");
const region = data.regions.find((r) => r.slug === Astro.props.slug);
const districts = data.districts
  .filter((d) => d.region === region.slug)
  .sort((a, b) => a.name.localeCompare(b.name));

const live = region.candidates
  .filter((c) => LIVE_STATUSES.includes(c.status))
  .sort((a, b) => a.name.localeCompare(b.name));
const ended = region.candidates.filter((c) => !LIVE_STATUSES.includes(c.status));
const partyName = (slug) => data.partyBySlug.get(slug)?.short_name ?? slug;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${region.name} — Legislative Council · 2026 Victorian election`,
  url: `${SITE.url}/regions/${region.slug}`,
  isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
};
---

<Base
  title={`${region.name} — Legislative Council`}
  description={`Sitting members and recorded 2026 candidates for the ${region.name} region of the Victorian Legislative Council.`}
  schema={schema}
  breadcrumbs={[
    { name: "Regions", href: "/regions" },
    { name: region.name, href: `/regions/${region.slug}` },
  ]}
>
  <div class="wrap section">
    <nav aria-label="Breadcrumb" class="crumb">
      <a href="/regions">Regions</a> <span aria-hidden="true">/</span>
      <span>{region.name}</span>
    </nav>

    <p class="eyebrow">Legislative Council · 5 members</p>
    <h1>{region.name}</h1>
    <p class="lede">
      Upper-house region electing five members by proportional representation. Sitting
      members below are who holds the seats <strong>today</strong>; 2026 ticket candidacies
      are listed only when individually sourced.
    </p>

    <dl class="facts">
      <div>
        <dt>Chamber</dt>
        <dd>Legislative Council</dd>
      </div>
      <div>
        <dt>Seats</dt>
        <dd>{region.seats}</dd>
      </div>
      <div>
        <dt>Assembly districts</dt>
        <dd>{districts.length}</dd>
      </div>
      <div>
        <dt>2026 candidates recorded</dt>
        <dd>{live.length || "—"}</dd>
      </div>
    </dl>

    <h2 class="sh">Sitting members now</h2>
    <p class="muted sub">
      Not a 2026 ticket. Mid-term replacements and party changes are included. See
      <a href="/methodology">methodology</a>.
    </p>
    <ul class="mlc-list" role="list">
      {
        region.members.map((m) => {
          const retiring = data.retirements.some(
            (x) => x.role === "MLC" && x.name === m.name
          );
          return (
            <li class="card mlc">
              <div class="mlc-head">
                <div>
                  <h3>{m.name}</h3>
                  <p class="cand-party">
                    <span
                      class="swatch"
                      style={`--party-colour:${partyColour(m.party)}`}
                      aria-hidden="true"
                    />
                    {partyName(m.party)}
                  </p>
                </div>
                {retiring && <span class="pill pill-withdrawn">Not recontesting</span>}
              </div>
              {m.note && <p class="muted m-note">{m.note}</p>}
              {m.source && (
                <p class="muted">
                  <SourceLink source={m.source} showAccessed={false} />
                </p>
              )}
            </li>
          );
        })
      }
    </ul>

    <h2 class="sh">Recorded 2026 candidates</h2>
    {
      live.length === 0 ? (
        <p class="empty card">
          No individually sourced Legislative Council candidacy has been recorded for{" "}
          {region.name} yet. That means we have not verified a ticket entry —{" "}
          <strong>not</strong> that no one will stand.{" "}
          <a href={SITE.issues}>Know of one? Send us the source.</a>
        </p>
      ) : (
        <ul class="cand-list" role="list">
          {live.map((c) => (
            <li class="card cand">
              <div class="cand-head">
                <div>
                  <h3>{c.name}</h3>
                  <p class="cand-party">
                    <span
                      class="swatch"
                      style={`--party-colour:${partyColour(c.party)}`}
                      aria-hidden="true"
                    />
                    <a href={`/parties/${c.party}`}>{partyName(c.party)}</a>
                  </p>
                  {(c.occupation || c.background) && (
                    <p class="cand-bio muted">
                      {c.occupation}
                      {c.occupation && c.background ? " · " : ""}
                      {c.background}
                    </p>
                  )}
                </div>
                <span class={`pill pill-${c.status}`}>{STATUS_LABELS[c.status]}</span>
              </div>
              <ol class="history" role="list">
                {c.history.map((h) => (
                  <li>
                    <span class="h-status">{STATUS_LABELS[h.status]}</span>
                    <span class="muted h-date">{formatDate(h.date)}</span>
                    <SourceLink source={h.source} />
                    {h.note && <p class="h-note">{h.note}</p>}
                  </li>
                ))}
              </ol>
              {c.links?.length > 0 && (
                <p class="cand-links muted">
                  {c.links.map((l) => {
                    const labels = {
                      "campaign-site": "Website",
                      "campaign-page": "Campaign",
                      parliament: "Parliament",
                      wikipedia: "Wikipedia",
                      "party-profile": "Party profile",
                      "candidate-profile": "Profile",
                      profile: "Profile",
                    };
                    const label = labels[l.kind] ?? l.kind ?? "link";
                    return (
                      <a
                        href={l.url}
                        target="_blank"
                        rel="nofollow noopener noreferrer"
                      >
                        {label}
                      </a>
                    );
                  })}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      ended.length > 0 && (
        <>
          <h2 class="sh">Withdrawn or disendorsed</h2>
          <ul class="cand-list" role="list">
            {ended.map((c) => (
              <li class="card cand">
                <div class="cand-head">
                  <div>
                    <h3>{c.name}</h3>
                    <p class="cand-party">
                      <span
                        class="swatch"
                        style={`--party-colour:${partyColour(c.party)}`}
                        aria-hidden="true"
                      />
                      {partyName(c.party)}
                    </p>
                  </div>
                  <span class={`pill pill-${c.status}`}>{STATUS_LABELS[c.status]}</span>
                </div>
                <ol class="history" role="list">
                  {c.history.map((h) => (
                    <li>
                      <span class="h-status">{STATUS_LABELS[h.status]}</span>
                      <span class="muted h-date">{formatDate(h.date)}</span>
                      <SourceLink source={h.source} />
                      {h.note && <p class="h-note">{h.note}</p>}
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2 class="sh">Assembly districts in this region</h2>
    <ul class="dist-links">
      {
        districts.map((d) => (
          <li>
            <a href={`/districts/${d.slug}`}>{d.name}</a>
          </li>
        ))
      }
    </ul>

    <p class="foot-note muted">
      Machine-readable:{" "}
      <a href="/data/vic2026/regions.json">regions.json</a> ·{" "}
      <a href="/data/vic2026/council-members.json">council-members.json</a> ·{" "}
      <a href="/data/vic2026/candidates.json">candidates.json</a>.{" "}
      <a href={SITE.issues}>Submit a correction</a>.
    </p>
  </div>
</Base>

<style>
  .crumb {
    font-size: 0.88rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  .crumb span[aria-hidden] {
    margin-inline: 0.3rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1.5rem 0 2rem;
  }
  .facts > div {
    background: var(--surface);
    padding: 0.9rem 1.1rem;
  }
  .facts dt {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }
  .facts dd {
    margin: 0;
    font-weight: 560;
  }
  .sh {
    margin-top: 2.5rem;
  }
  .sub {
    max-width: 46rem;
    margin-bottom: 1rem;
  }
  .empty {
    color: var(--ink-2);
    max-width: 46rem;
  }
  .mlc-list,
  .cand-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .cand-head,
  .mlc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cand h3,
  .mlc h3 {
    margin: 0 0 0.2rem;
    font-size: 1.1rem;
  }
  .cand-party {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
  }
  .cand-bio {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
  }
  .m-note {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
  }
  .history {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--rule);
    display: grid;
    gap: 0.7rem;
  }
  .history li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    font-size: 0.9rem;
  }
  .h-status {
    font-weight: 620;
  }
  .h-date {
    font-variant-numeric: tabular-nums;
  }
  .h-note {
    flex-basis: 100%;
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    color: var(--ink-2);
  }
  .cand-links {
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .dist-links {
    columns: 2;
    gap: 1.5rem;
    max-width: 40rem;
    padding-left: 1.15rem;
  }
  @media (max-width: 40rem) {
    .dist-links {
      columns: 1;
    }
  }
  .foot-note {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
</style>
