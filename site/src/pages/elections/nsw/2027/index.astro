---
import Base from "../../../../layouts/Base.astro";
import SourceLink from "../../../../components/SourceLink.astro";
import {
  loadStateFoundationElection,
  stateFoundationSummaryFor,
  stateFoundationRepresentationFor,
} from "../../../../../../scripts/lib/state-foundation.mjs";
import { SITE, NSW2027, partyColour, formatDate } from "../../../../lib/site.mjs";
import { ELECTION_DATE_STATUS } from "../../../../lib/electionCalendar.mjs";
import { loadElectionPlaceholders } from "../../../../lib/electionPlaceholders.mjs";

const data = loadStateFoundationElection("nsw2027");
const summary = stateFoundationSummaryFor(data);
const rep = stateFoundationRepresentationFor(data);
const { election } = data;
const placeholder = loadElectionPlaceholders().find((e) => e.planned_path === NSW2027);
const dateStatus = ELECTION_DATE_STATUS[election.date_status] ?? ELECTION_DATE_STATUS.confirmed;

const retirementsByDate = [...data.retirements].sort((a, b) =>
  b.announced.localeCompare(a.announced)
);
const districtName = new Map(data.districts.map((d) => [d.slug, d.name]));
const partyShort = (slug) => {
  const p = data.partyBySlug.get(slug);
  return p?.short_name || p?.name || slug;
};
const candidatesByParty = data.parties
  .map((p) => {
    const rows = data.candidates.filter((c) => c.party === p.slug);
    return {
      ...p,
      count: rows.length,
      assembly: rows.filter((c) => c.chamber === "assembly").length,
      council: rows.filter((c) => c.chamber === "council").length,
    };
  })
  .filter((p) => p.count > 0)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const partyRows = data.parties
  .map((p) => {
    const r = rep[p.slug] ?? { assembly: 0, council: 0, total: 0 };
    return { ...p, ...r };
  })
  .filter((p) => p.total > 0)
  .sort((a, b) => b.total - a.total || a.name.localeCompare(b.name));

const schema = {
  "@type": "WebPage",
  name: election.name,
  description: `${election.name}: sourced candidates and retirements, sitting members of the ${election.sitting_parliament_label}, and Legislative Assembly and Legislative Council structure.`,
  url: `${SITE.url}${NSW2027}`,
  isPartOf: { "@id": `${SITE.url}/#website` },
};
---

<Base
  title={election.name}
  description={`Sourced candidates and retirements for the 2027 NSW state election, plus sitting members of the ${election.sitting_parliament_label}: 93 Assembly districts and Legislative Council composition.`}
  schema={schema}
  breadcrumbs={[
    { name: "Upcoming elections", href: "/elections" },
    { name: election.name, href: NSW2027 },
  ]}
>
  <div class="wrap section fed-home">
    <nav aria-label="Breadcrumb" class="crumb">
      <a href="/elections">Upcoming elections</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">NSW</span>
    </nav>

    <p class="eyebrow">New South Wales · Election for the {election.parliament_label}</p>
    <h1>{election.name}</h1>
    <p class="lede">
      Voters elect all <strong>{election.assembly_seats}</strong> members of the Legislative
      Assembly and <strong>{election.council_seats_up}</strong> of the Legislative Council’s
      <strong>{election.council_seats}</strong> places — forming the
      <strong>{election.parliament_label}</strong>.
    </p>

    <div class="date-line">
      <strong>{election.date_label}</strong>
      <span class={`date-status status-${election.date_status}`}>{dateStatus.label}</span>
    </div>
    <p class="muted date-basis">
      Polling day {formatDate(election.election_day)} (NSW Electoral Commission fixed cycle).
    </p>

    <div class="notice" role="note">
      <strong>Sitting members and an early candidates ledger.</strong>
      {election.tracking_status}
      Members listed here sit in the <strong>{election.sitting_parliament_label}</strong>. They are
      <em>not</em> automatically candidates for {election.date_label}; only people with an
      individually sourced record appear in the <a href={`${NSW2027}/candidates`}>candidates ledger</a>.
    </div>

    <dl class="facts">
      <div>
        <dt>Parliament electing</dt>
        <dd>{election.parliament_label}</dd>
      </div>
      <div>
        <dt>Sitting parliament</dt>
        <dd>{election.sitting_parliament_label}</dd>
      </div>
      <div>
        <dt>Assembly districts</dt>
        <dd>{summary.districts}</dd>
      </div>
      <div>
        <dt>Sitting MLAs / MLCs</dt>
        <dd>{summary.assembly_members} / {summary.council_members}</dd>
      </div>
      <div>
        <dt>Sourced candidacies</dt>
        <dd>{summary.live_candidates}</dd>
      </div>
      <div>
        <dt>MPs not recontesting</dt>
        <dd>{summary.retirements}</dd>
      </div>
      <div>
        <dt>Council places up</dt>
        <dd>{summary.council_up}</dd>
      </div>
      <div>
        <dt>Data id</dt>
        <dd class="mono">nsw2027</dd>
      </div>
    </dl>

    <p class="btn-row">
      <a class="btn" href={`${NSW2027}/candidates`}>Candidates</a>
      <a class="btn btn-ghost" href={`${NSW2027}/districts`}>Districts</a>
      <a class="btn btn-ghost" href={`${NSW2027}/assembly`}>Legislative Assembly</a>
      <a class="btn btn-ghost" href={`${NSW2027}/council`}>Legislative Council</a>
      <a class="btn btn-ghost" href={`${NSW2027}/parties`}>Parties</a>
      <a class="btn btn-ghost" href={`${NSW2027}/polls`}>Polls</a>
      <a class="btn btn-ghost" href={`${NSW2027}/data`}>Open data</a>
    </p>

    <section aria-labelledby="ledger-h">
      <p class="eyebrow">2027 candidacies</p>
      <h2 id="ledger-h">Candidates and retirements</h2>
      <p class="muted">
        {summary.assembly_candidates} sourced Legislative Assembly candidacies across
        {summary.districts_with_candidates} districts, {summary.council_candidates} Legislative
        Council candidates, and {summary.retirements} sitting MPs who have
        confirmed they will not recontest. Each record cites a dated party page or news report.
        Formal nominations close on 24 February 2027.
      </p>
      <ul class="cand-strip" role="list" aria-label="Sourced candidacies by party">
        {
          candidatesByParty.map((p) => (
            <li>
              <span class="swatch" style={`background:${partyColour(p.slug)}`} aria-hidden="true" />
              <strong>{p.count}</strong>
              <span class="muted">
                {p.short_name || p.name}
                {p.council > 0 && ` (${p.assembly} LA, ${p.council} LC)`}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="muted strip-key">LA = Legislative Assembly, LC = Legislative Council.</p>
      <h3 class="sub-h">Not recontesting</h3>
      <ul class="retire-list" role="list">
        {
          retirementsByDate.map((r) => (
            <li>
              <a href={`${NSW2027}/districts/${r.seat}`}>{r.name}</a>
              <span class="muted">
                {" "}({partyShort(r.party)}, {districtName.get(r.seat) ?? r.seat}) · announced{" "}
                {formatDate(r.announced)}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="btn-row">
        <a class="btn btn-ghost" href={`${NSW2027}/candidates`}>Full candidates and retirements ledger</a>
        <a class="btn btn-ghost" href="/data/nsw2027/candidates.json">candidates.json</a>
      </p>
    </section>

    <section aria-labelledby="composition-h">
      <p class="eyebrow">58th Parliament</p>
      <h2 id="composition-h">Current composition (sitting seats)</h2>
      <p class="muted">
        Seats held now, including mid-term changes. Not a forecast and not a 2023 election result
        frozen in time if a by-election or casual vacancy has occurred.
      </p>
      <div class="party-grid">
        {
          partyRows.map((p) => (
            <a class="card card-interactive party-card" href={`${NSW2027}/parties/${p.slug}`}>
              <header>
                <span class="swatch" style={`background:${partyColour(p.slug)}`} aria-hidden="true" />
                <h3>{p.short_name || p.name}</h3>
              </header>
              <dl>
                <div>
                  <dt>Assembly</dt>
                  <dd>{p.assembly}</dd>
                </div>
                <div>
                  <dt>Council</dt>
                  <dd>{p.council}</dd>
                </div>
                <div>
                  <dt>Total</dt>
                  <dd>{p.total}</dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section compact" aria-labelledby="structure-h">
      <p class="eyebrow">Structure</p>
      <h2 id="structure-h">What voters elect</h2>
      <div class="card-grid-wide">
        {
          (placeholder?.chambers ?? []).map((chamber) => (
            <article class="card chamber-card">
              <header>
                <div>
                  <p class="chamber-role">{chamber.role}</p>
                  <h3>{chamber.name}</h3>
                </div>
                <strong class="seat-count">{chamber.seats} seats</strong>
              </header>
              <dl>
                <div>
                  <dt>Electorates</dt>
                  <dd>{chamber.constituencies}</dd>
                </div>
                <div>
                  <dt>At this election</dt>
                  <dd>{chamber.election_scope}</dd>
                </div>
                <div>
                  <dt>Voting system</dt>
                  <dd>{chamber.voting_system}</dd>
                </div>
                {chamber.term && (
                  <div>
                    <dt>Term</dt>
                    <dd>{chamber.term}</dd>
                  </div>
                )}
              </dl>
              {chamber.name === "Legislative Assembly" ? (
                <p class="chamber-link">
                  <a href={`${NSW2027}/districts`}>Browse {summary.districts} districts →</a>
                </p>
              ) : (
                <p class="chamber-link">
                  <a href={`${NSW2027}/council`}>Browse Council composition →</a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    {
      election.notes?.length > 0 && (
        <section class="section compact" aria-labelledby="notes-h">
          <h2 id="notes-h">Important details</h2>
          <ul>
            {election.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section compact" aria-labelledby="src-h">
      <h2 id="src-h">Sources</h2>
      <ul class="source-list">
        {
          (election.membership_sources ?? election.sources ?? []).map((s) => (
            <li>
              <SourceLink source={s} />
            </li>
          ))
        }
      </ul>
    </section>

    <p class="back"><a class="btn btn-ghost" href="/elections">Back to upcoming elections</a></p>
  </div>
</Base>

<style>
  .fed-home { max-width: 70rem; }
  .crumb { font-size: 0.88rem; color: var(--ink-3); margin-bottom: 1rem; }
  .crumb span[aria-hidden] { margin-inline: 0.35rem; }
  .date-line { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .date-line strong { font-size: 1.2rem; }
  .date-basis { max-width: 52rem; }
  .date-status {
    display: inline-flex; padding: 0.22rem 0.5rem; border: 1px solid var(--rule-strong);
    border-radius: 999px; background: var(--surface-2); font-size: 0.72rem; font-weight: 700;
  }
  .notice { margin: 1.5rem 0; }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1px;
    background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius);
    overflow: hidden; margin: 1.5rem 0 1.5rem;
  }
  .facts > div { background: var(--surface); padding: 1rem 1.1rem; }
  .facts dt, .party-card dt, .chamber-card dt {
    font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3);
  }
  .facts dd { margin: 0.25rem 0 0; font-weight: 650; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 0.65rem; margin: 1rem 0 2rem; }
  .party-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 0.75rem;
  }
  .party-card header { display: flex; align-items: center; gap: 0.55rem; }
  .party-card h3 { margin: 0; font-size: 1rem; }
  .swatch { width: 0.7rem; height: 0.7rem; border-radius: 999px; flex-shrink: 0; }
  .party-card dl {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.35rem; margin: 0.75rem 0 0;
  }
  .party-card dd { margin: 0.1rem 0 0; font-weight: 650; }
  .chamber-card header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .chamber-card h3 { margin: 0.15rem 0 0; }
  .chamber-role { margin: 0; color: var(--ink-3); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .seat-count { white-space: nowrap; font-size: 0.95rem; }
  .chamber-card dl { display: grid; gap: 0.85rem; margin-bottom: 0.75rem; }
  .chamber-card dd { margin: 0.15rem 0 0; color: var(--ink-2); }
  .chamber-link { margin: 0; font-size: 0.92rem; }
  .compact { max-width: 52rem; }
  .cand-strip { list-style: none; padding: 0; margin: 0.75rem 0 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .strip-key { font-size: 0.82rem; margin: -0.5rem 0 1rem; }
  .cand-strip li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sub-h { font-size: 1rem; margin: 1rem 0 0.4rem; }
  .retire-list { list-style: none; padding: 0; margin: 0 0 0.5rem; display: grid; gap: 0.3rem; font-size: 0.92rem; }
  .compact ul, .source-list { padding-left: 1.2rem; display: grid; gap: 0.45rem; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
  .back { margin-top: 2.5rem; }
</style>
