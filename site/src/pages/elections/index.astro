---
import Base from "../../layouts/Base.astro";
import SourceLink from "../../components/SourceLink.astro";
import { SITE } from "../../lib/site.mjs";
import { ELECTION_DATE_STATUS, loadElectionCalendar } from "../../lib/electionCalendar.mjs";

const calendar = loadElectionCalendar();
const schema = {
  "@type": "CollectionPage",
  name: "Upcoming Australian elections",
  description: "Sourced dates, expected years and lawful date windows for the next federal, state and territory parliamentary elections in Australia.",
  url: `${SITE.url}/elections`,
  isPartOf: { "@id": `${SITE.url}/#website` },
  dateModified: calendar.updated,
};
---

<Base
  title="Upcoming Australian elections"
  description="The next federal, state and territory parliamentary elections in Australia, distinguishing confirmed dates, fixed-cycle calculations, legal windows and elections with no fixed date."
  schema={schema}
>
  <div class="wrap section calendar-page">
    <p class="eyebrow">Australian election calendar</p>
    <h1>Upcoming elections</h1>
    <p class="lede">
      The next general parliamentary election for the Commonwealth and every state and
      territory. Each entry states how certain the date is and cites the authoritative source.
    </p>

    <div class="notice" role="note">
      <strong>Dates are not all equally certain.</strong> Calculated statutory dates are not
      described as announced dates. By-elections, local elections and referendums are outside
      this calendar unless separately added.
    </div>

    <div class="calendar-list">
      {calendar.elections.map((entry) => {
        const status = ELECTION_DATE_STATUS[entry.status];
        const live = entry.jurisdiction === "vic";
        return (
          <article class={`election-card card ${live ? "is-live" : ""}`}>
            <header>
              <div>
                <p class="jurisdiction">{entry.name}</p>
                <h2>{entry.date_label}</h2>
              </div>
              <span class={`date-status status-${entry.status}`}>{status.label}</span>
            </header>
            <p class="election-name">{entry.election_name}</p>
            <p>{entry.basis}</p>
            {entry.note && <p class="muted">{entry.note}</p>}
            <p>
              <a class={`btn ${live ? "" : "btn-ghost"}`} href={entry.planned_path}>
                {live ? "Open active tracker" : "View election outline"}
              </a>
            </p>
            <p class="source"><SourceLink source={entry.source} /></p>
          </article>
        );
      })}
    </div>

    <section class="section periodic" aria-labelledby="periodic-h">
      <p class="eyebrow">Separate parliamentary cycle</p>
      <h2 id="periodic-h">Tasmania’s Legislative Council</h2>
      <p>Two or three divisions vote each May on a rotating six-year cycle, separately from the House of Assembly.</p>
      {calendar.periodicElections.map((entry) => (
        <article class="card periodic-card">
          <div>
            <h3>{entry.date_label}</h3>
            <p>{entry.election_name}</p>
            <p>{entry.basis}</p>
            <p><strong>Divisions:</strong> {entry.contests.join(", ")}</p>
          </div>
          <div class="periodic-actions">
            <p><a class="btn btn-ghost" href={entry.planned_path}>View election outline</a></p>
            <SourceLink source={entry.source} />
          </div>
        </article>
      ))}
    </section>

    <section class="section" aria-labelledby="labels-h">
      <p class="eyebrow">Methodology</p>
      <h2 id="labels-h">What the labels mean</h2>
      <dl class="legend">
        {Object.entries(ELECTION_DATE_STATUS).map(([key, item]) => (
          <div><dt><span class={`date-status status-${key}`}>{item.label}</span></dt><dd>{item.explanation}</dd></div>
        ))}
      </dl>
      <p><a href="/methodology#election-dates">Full election-date methodology</a></p>
    </section>
  </div>
</Base>

<style>
  .calendar-page { max-width: 70rem; }
  .calendar-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .election-card header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .election-card h2 { margin: 0.1rem 0 0; font-size: 1.35rem; }
  .election-card.is-live { border-color: var(--accent); }
  .jurisdiction { margin: 0; color: var(--ink-3); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .election-name { font-weight: 650; }
  .date-status { display: inline-flex; padding: 0.22rem 0.5rem; border: 1px solid var(--rule-strong); border-radius: 999px; background: var(--surface-2); font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
  .status-confirmed { border-color: var(--accent); background: var(--accent-wash); }
  .source { margin-bottom: 0; }
  .periodic-card { display: grid; grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr); gap: 1rem; }
  .periodic-card h3 { margin-top: 0; }
  .periodic-actions { align-self: start; }
  .legend { display: grid; gap: 0.75rem; }
  .legend div { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; align-items: start; }
  .legend dd { margin: 0; color: var(--ink-2); }
  @media (max-width: 42rem) { .periodic-card, .legend div { grid-template-columns: 1fr; } }
</style>
