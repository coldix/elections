---
import Base from "../../../../../layouts/Base.astro";
import SourceLink from "../../../../../components/SourceLink.astro";
import {
  loadFederalElection,
  federalSummaryFor,
  STATE_LABELS,
  STATE_ORDER,
} from "../../../../../../../scripts/lib/federal.mjs";
import { SITE, FEDERAL_49, partyColour } from "../../../../../lib/site.mjs";

const data = loadFederalElection("federal-49");
const summary = federalSummaryFor(data);
const { election } = data;

const termLabel = {
  up: "Up at next half-Senate",
  continuing: "Continuing (to 2031)",
  territory: "Territory (with House)",
  unknown: "Term status unclear",
};

const byState = STATE_ORDER.map((state) => {
  const contest = data.senateContests.find((c) => c.slug === state);
  const members = (contest?.members ?? data.senateMembers.filter((m) => m.state === state))
    .slice()
    .sort((a, b) => {
      const order = { up: 0, territory: 1, continuing: 2, unknown: 3 };
      return (order[a.term_status] ?? 9) - (order[b.term_status] ?? 9) || a.name.localeCompare(b.name);
    });
  return { state, label: STATE_LABELS[state], contest, members };
});

const schema = {
  "@type": "WebPage",
  name: "Senate — next federal election",
  description: `Australian Senate composition in the ${election.sitting_parliament_label}, with who is ordinarily up at the next half-Senate election.`,
  url: `${SITE.url}${FEDERAL_49}/senate`,
};
---

<Base
  title="Senate"
  description={`Senate composition for the ${election.sitting_parliament_label}: who is up at the next half-Senate election and who continues.`}
  schema={schema}
  breadcrumbs={[
    { name: "Upcoming elections", href: "/elections" },
    { name: "Federal", href: FEDERAL_49 },
    { name: "Senate", href: `${FEDERAL_49}/senate` },
  ]}
>
  <div class="wrap section">
    <nav aria-label="Breadcrumb" class="crumb">
      <a href="/elections">Upcoming elections</a>
      <span aria-hidden="true">/</span>
      <a href={FEDERAL_49}>Federal</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Senate</span>
    </nav>

    <p class="eyebrow">Federal · {election.sitting_parliament_label} · Upper house</p>
    <h1>Senate</h1>
    <p class="lede">
      <strong>{summary.senate_members}</strong> senators: twelve from each state and two from each
      territory. At a normal simultaneous election, about
      <strong>{election.senate_seats_up_normal}</strong> places are contested (six per state plus both
      territory places). A double dissolution would put all {election.senate_seats} to election.
    </p>

    <dl class="facts">
      <div>
        <dt>Ordinarily up (state)</dt>
        <dd>{summary.senate_up}</dd>
      </div>
      <div>
        <dt>Continuing (to 2031)</dt>
        <dd>{summary.senate_continuing}</dd>
      </div>
      <div>
        <dt>Territory (with House)</dt>
        <dd>{summary.senate_territory}</dd>
      </div>
    </dl>

    <div class="notice" role="note">
      <strong>Term status is structural, not a candidacy.</strong> “Up” means the senator’s state
      term ends at the next half-Senate cycle — not that they have announced they will recontest.
    </div>

    <p class="btn-row">
      <a class="btn btn-ghost btn-sm" href={FEDERAL_49}>Federal overview</a>
      <a class="btn btn-ghost btn-sm" href={`${FEDERAL_49}/representatives`}>House</a>
      <a class="btn btn-ghost btn-sm" href="/data/federal-49/senate-members.json">senate-members.json</a>
    </p>

    <nav class="jump" aria-label="Jump to state or territory">
      {
        byState.map(({ state, label, members }) => (
          <a href={`#state-${state}`}>
            {label} <span class="muted">({members.length})</span>
          </a>
        ))
      }
    </nav>

    {
      byState.map(({ state, label, contest, members }) => (
        <section class="state-block" id={`state-${state}`} aria-labelledby={`h-${state}`}>
          <h2 id={`h-${state}`}>{label}</h2>
          {contest && <p class="muted scope">{contest.election_scope}</p>}
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Senator</th>
                  <th scope="col">Party</th>
                  <th scope="col">End term</th>
                  <th scope="col">At next half-Senate</th>
                </tr>
              </thead>
              <tbody>
                {members.map((m) => {
                  const party = data.partyBySlug.get(m.party);
                  return (
                    <tr class={`term-${m.term_status}`}>
                      <td>{m.name}</td>
                      <td>
                        <span class="party-cell">
                          <span
                            class="swatch"
                            style={`background:${partyColour(m.party)}`}
                            aria-hidden="true"
                          />
                          {party?.short_name ?? m.party}
                        </span>
                      </td>
                      <td>{m.end_term ?? (m.term_status === "territory" ? "with House" : "—")}</td>
                      <td>
                        <span class={`term-badge term-${m.term_status}`}>
                          {termLabel[m.term_status] ?? m.term_status}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }

    <section class="section compact sources" aria-labelledby="sources-h">
      <h2 id="sources-h">Source</h2>
      {data.sources.senate && <p><SourceLink source={data.sources.senate} /></p>}
      <p class="muted">
        Prefer the Parliament of Australia handbook for named-person verification. Territory
        senators always face voters with the House.
      </p>
    </section>
  </div>
</Base>

<style>
  .crumb { font-size: 0.88rem; color: var(--ink-3); margin-bottom: 1rem; }
  .crumb span[aria-hidden] { margin-inline: 0.35rem; }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1px;
    background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius);
    overflow: hidden; margin: 1.25rem 0;
  }
  .facts > div { background: var(--surface); padding: 1rem 1.1rem; }
  .facts dt { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .facts dd { margin: 0.25rem 0 0; font-weight: 650; }
  .notice { margin: 1rem 0 1.25rem; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
  .jump {
    display: flex; flex-wrap: wrap; gap: 0.45rem 0.85rem; margin: 1.25rem 0 2rem; font-size: 0.92rem;
  }
  .state-block { margin-bottom: 2.25rem; }
  .scope { margin: -0.25rem 0 0.65rem; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--rule); }
  th { background: var(--surface-2); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  tr:last-child td { border-bottom: none; }
  .party-cell { display: inline-flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 0.55rem; height: 0.55rem; border-radius: 999px; flex-shrink: 0; }
  .term-badge {
    display: inline-block; font-size: 0.78rem; font-weight: 650; padding: 0.15rem 0.45rem;
    border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--surface-2);
  }
  .term-up { border-color: var(--accent); background: var(--accent-wash); }
  .term-territory { border-color: var(--rule-strong); }
  .term-continuing { opacity: 0.9; }
  .compact { max-width: 40rem; }
</style>
