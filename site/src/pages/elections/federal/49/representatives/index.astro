---
import Base from "../../../../../layouts/Base.astro";
import SourceLink from "../../../../../components/SourceLink.astro";
import {
  loadFederalElection,
  federalSummaryFor,
  STATE_LABELS,
  STATE_ORDER,
} from "../../../../../../../scripts/lib/federal.mjs";
import { SITE, FEDERAL_49, partyColour } from "../../../../../lib/site.mjs";

const data = loadFederalElection("federal-49");
const summary = federalSummaryFor(data);
const { election } = data;

const byState = STATE_ORDER.map((state) => {
  const divisions = data.divisions
    .filter((d) => d.state === state)
    .sort((a, b) => a.name.localeCompare(b.name));
  return { state, label: STATE_LABELS[state], divisions };
}).filter((g) => g.divisions.length > 0);

const schema = {
  "@type": "WebPage",
  name: "House of Representatives — next federal election",
  description: `All ${summary.divisions} federal electoral divisions and sitting members of the ${election.sitting_parliament_label}.`,
  url: `${SITE.url}${FEDERAL_49}/representatives`,
};
---

<Base
  title="House of Representatives"
  description={`All ${summary.divisions} House of Representatives divisions for the next federal election, with sitting members of the ${election.sitting_parliament_label}.`}
  schema={schema}
  breadcrumbs={[
    { name: "Upcoming elections", href: "/elections" },
    { name: "Federal", href: FEDERAL_49 },
    { name: "Representatives", href: `${FEDERAL_49}/representatives` },
  ]}
>
  <div class="wrap section">
    <nav aria-label="Breadcrumb" class="crumb">
      <a href="/elections">Upcoming elections</a>
      <span aria-hidden="true">/</span>
      <a href={FEDERAL_49}>Federal</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Representatives</span>
    </nav>

    <p class="eyebrow">Federal · {election.sitting_parliament_label} · Lower house</p>
    <h1>House of Representatives</h1>
    <p class="lede">
      <strong>{summary.divisions}</strong> single-member electoral divisions. The next election
      returns all seats for the <strong>{election.parliament_label}</strong>. Names below are
      <em>sitting</em> members of the {election.sitting_parliament_label} — not a candidacy list.
    </p>

    <p class="btn-row">
      <a class="btn btn-ghost btn-sm" href={FEDERAL_49}>Federal overview</a>
      <a class="btn btn-ghost btn-sm" href={`${FEDERAL_49}/senate`}>Senate</a>
      <a class="btn btn-ghost btn-sm" href="/data/federal-49/divisions.json">divisions.json</a>
    </p>

    <nav class="jump" aria-label="Jump to state or territory">
      {
        byState.map(({ state, label, divisions }) => (
          <a href={`#state-${state}`}>
            {label} <span class="muted">({divisions.length})</span>
          </a>
        ))
      }
    </nav>

    {
      byState.map(({ state, label, divisions }) => (
        <section class="state-block" id={`state-${state}`} aria-labelledby={`h-${state}`}>
          <h2 id={`h-${state}`}>
            {label} <span class="muted count">{divisions.length}</span>
          </h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Division</th>
                  <th scope="col">Sitting member</th>
                  <th scope="col">Party</th>
                </tr>
              </thead>
              <tbody>
                {divisions.map((d) => {
                  const party = data.partyBySlug.get(d.incumbent_party);
                  return (
                    <tr>
                      <td>
                        <a href={`${FEDERAL_49}/representatives/${d.slug}`}>{d.name}</a>
                      </td>
                      <td>{d.incumbent ?? "—"}</td>
                      <td>
                        <span class="party-cell">
                          <span
                            class="swatch"
                            style={`background:${partyColour(d.incumbent_party)}`}
                            aria-hidden="true"
                          />
                          {party?.short_name ?? d.incumbent_party ?? "—"}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }

    <section class="section compact sources" aria-labelledby="sources-h">
      <h2 id="sources-h">Source</h2>
      {data.sources.house && <p><SourceLink source={data.sources.house} /></p>}
      <p class="muted">
        Sitting member ≠ candidate. Prefer the Parliament of Australia for named-person
        verification.
      </p>
    </section>
  </div>
</Base>

<style>
  .crumb { font-size: 0.88rem; color: var(--ink-3); margin-bottom: 1rem; }
  .crumb span[aria-hidden] { margin-inline: 0.35rem; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
  .jump {
    display: flex; flex-wrap: wrap; gap: 0.45rem 0.85rem; margin: 1.25rem 0 2rem;
    font-size: 0.92rem;
  }
  .state-block { margin-bottom: 2.25rem; }
  .state-block h2 { margin-bottom: 0.65rem; }
  .count { font-weight: 500; font-size: 0.85em; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--rule); }
  th { background: var(--surface-2); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  tr:last-child td { border-bottom: none; }
  .party-cell { display: inline-flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 0.55rem; height: 0.55rem; border-radius: 999px; flex-shrink: 0; }
  .compact { max-width: 40rem; }
</style>
