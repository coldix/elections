---
import Base from "../layouts/Base.astro";
import Countdown from "../components/Countdown.astro";
import StatGrid from "../components/StatGrid.astro";
import PollAverageBoard from "../components/PollAverageBoard.astro";
import SurveyInvite from "../components/SurveyInvite.astro";
import AdRow from "../components/AdRow.astro";
import { SITE, VIC2026, FEDERAL_49, formatDate } from "../lib/site.mjs";
import { loadElection, summaryFor } from "../../../scripts/lib/data.mjs";
import { loadPolls, computePollAverage } from "../../../scripts/lib/polls.mjs";
import { ELECTION_DATE_STATUS, loadElectionCalendar } from "../lib/electionCalendar.mjs";

const data = loadElection("vic2026");
const summary = summaryFor(data);
const vicPollAverage = computePollAverage(loadPolls("vic2026"));
const federalPollAverage = computePollAverage(loadPolls("federal-49"));
const calendar = loadElectionCalendar();
const victoria = calendar.elections.find((entry) => entry.jurisdiction === "vic");
const nextElections = calendar.elections.filter((entry) => entry.jurisdiction !== "vic").slice(0, 4);

const vicStats = [
  { value: summary.live_candidates, label: "Live candidacies", note: "Individually sourced" },
  { value: summary.districts, label: "Assembly districts" },
  { value: summary.regions, label: "Council regions" },
  { value: summary.sources, label: "Sources cited" },
];

/** Primary ways into the active tracker. */
const vicEntry = [
  { href: `${VIC2026}/assembly`, title: "Candidates by seat", body: "All 88 Assembly districts with sourced statuses." },
  { href: `${VIC2026}/polls`, title: "Poll average", body: "Public statewide primaries and a transparent weighted average." },
  { href: `${VIC2026}/parties`, title: "Parties and policies", body: "Registered parties and sourced positions, compared side by side." },
  { href: `${VIC2026}/data`, title: "Open data", body: "JSON and CSV under /data/vic2026/ — CC BY 4.0." },
];

/** How to check the work — evidence, provenance and corrections in one place. */
const checkTheWork = [
  { href: "/methodology", title: "Methodology", body: "One set of evidence and neutrality rules for every contest." },
  { href: SITE.issues, title: "Submit a correction", body: "Provide a public source and a date. Corrections are recorded, not quietly edited." },
  { href: "/llms.txt", title: "Guide for AI systems", body: "Short index for crawlers and language models. Full version at /llms-full.txt." },
];

const schema = [
  {
    "@type": "CollectionPage",
    name: "Australian Election Tracker",
    description: SITE.descriptionLong,
    url: SITE.url,
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: [
      { "@type": "Thing", name: "Elections in Australia" },
      { "@type": "Thing", name: "2026 Victorian state election" },
    ],
    mainEntity: { "@id": `${SITE.url}/#organization` },
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is the Australian Election Tracker?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "An independent, public-interest ledger of Australian election information: " +
            "sourced candidates, parties, policies, statewide poll averages and open JSON/CSV. " +
            "It is not the electoral commission and does not publish forecasts or how-to-vote cards.",
        },
      },
      {
        "@type": "Question",
        name: "When is the 2026 Victorian state election?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "The Victorian state election is scheduled for Saturday 28 November 2026. " +
            "Formal nominations and key dates are set by the Victorian Electoral Commission (VEC).",
        },
      },
      {
        "@type": "Question",
        name: "Where is the open election data?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "Machine-readable exports live under https://electiontracker.au/data/vic2026/ " +
            "(candidates, districts, polls, policies, coverage). Data is licensed CC BY 4.0; " +
            "attribute as electiontracker.au.",
        },
      },
      {
        "@type": "Question",
        name: "Is coverage a complete list of every candidate?",
        acceptedAnswer: {
          "@type": "Answer",
          text:
            "No. Coverage counts only candidacies with an individually sourced public record. " +
            "An empty seat means none has been verified yet, not that nobody is standing. " +
            "The VEC remains authoritative after formal nominations.",
        },
      },
    ],
  },
];
---

<Base
  title="Australian election candidates, polls and open data"
  description="Independent Australian election tracker: sourced candidates, parties, policies and poll averages. Active ledger for the Victorian state election 28 November 2026. Open JSON/CSV — not a forecast."
  schema={schema}
>
  <section class="hero national-hero">
    <div class="wrap">
      <p class="eyebrow">Independent · Sourced · Australia-wide</p>
      <h1>Australian elections, one evidence trail.</h1>
      <p class="lede">
        Track <strong>who is standing</strong>, with a dated public source behind every
        material claim — plus parties, policy comparisons and a transparent statewide
        <strong>poll average</strong>.
      </p>
      <p class="btn-row hero-actions">
        <a class="btn" href={VIC2026}>Open the Victoria 2026 tracker</a>
        <a class="btn btn-ghost" href="/elections">Upcoming elections</a>
      </p>
      <p class="hero-facts">
        <span><strong>{summary.live_candidates}</strong> sourced candidacies</span>
        <span><strong>{summary.sources}</strong> cited sources</span>
        <span>Victoria votes <strong>{victoria?.date_label ?? "28 November 2026"}</strong></span>
      </p>
    </div>
  </section>

  <div class="wrap national-body">
    <section class="section" aria-labelledby="current-h">
      <div class="section-head">
        <p class="eyebrow">Current active tracker</p>
        <h2 id="current-h">2026 Victorian state election</h2>
        <p>
          Individually sourced candidacies across all 88 Assembly districts and eight
          Legislative Council regions, plus parties, policies, polling and open data.
        </p>
      </div>

      <Countdown election={data.election} keyDates={data.election.dates} />

      <StatGrid stats={vicStats} />

      <div class="card-grid entry-grid">
        {
          vicEntry.map((item) => (
            <a class="card link-card" href={item.href}>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </a>
          ))
        }
      </div>

      <p class="section-aside">
        Coverage is progressive: an empty seat means no candidacy has been verified yet, not
        that nobody is standing. Last Victorian source verification&nbsp;
        {formatDate(summary.latest_verified)}.
      </p>
    </section>

    <section class="section" aria-labelledby="polls-h">
      <div class="section-head">
        <p class="eyebrow">Two ledgers, two dates</p>
        <h2 id="polls-h">Poll averages</h2>
        <p>
          Victorian Assembly and federal House are separate averages. The as-of date is the
          latest fieldwork in each window — they are not interchangeable.
        </p>
      </div>
      <div class="poll-pair">
        <PollAverageBoard
          average={vicPollAverage}
          jurisdiction="vic"
          variant="teaser"
          href={`${VIC2026}/polls`}
        />
        <PollAverageBoard
          average={federalPollAverage}
          jurisdiction="federal"
          variant="teaser"
          href={`${FEDERAL_49}/polls`}
        />
      </div>
    </section>

    <section class="section" aria-labelledby="next-h">
      <div class="section-head">
        <p class="eyebrow">National calendar</p>
        <h2 id="next-h">What comes next</h2>
      </div>
      <div class="card-grid">
        {
          nextElections.map((entry) => {
            const status = ELECTION_DATE_STATUS[entry.status];
            return (
              <a class="card link-card upcoming-card" href={entry.planned_path}>
                <h3>{entry.name}</h3>
                <p class="upcoming-date">{entry.date_label}</p>
                <p class="muted">
                  {status.label}: {entry.basis}
                </p>
              </a>
            );
          })
        }
      </div>
      <p class="section-aside">
        <a href="/elections">Full Australian election calendar</a>
      </p>
    </section>

    <SurveyInvite />

    <section class="section" aria-labelledby="trust-h">
      <div class="section-head">
        <p class="eyebrow">Evidence and provenance</p>
        <h2 id="trust-h">Check the work</h2>
        <p>
          Nothing here is a forecast, a ranking or how-to-vote advice. Every claim should be
          checkable, so the rules and the full history are public.
        </p>
      </div>
      <div class="card-grid">
        {
          checkTheWork.map((item) => (
            <a class="card link-card" href={item.href}>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </a>
          ))
        }
      </div>
      <p class="section-aside">
        Every change stays reviewable in the <a href={SITE.repo}>public repository</a>. Publisher,
        authorisation and project boundaries are on the <a href="/about">about page</a>.
      </p>
    </section>
    <AdRow />
  </div>
</Base>

<style>
  .national-hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(60rem 24rem at 12% -8%, var(--accent-wash), transparent 70%),
      var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .national-hero h1 {
    max-width: 18ch;
  }
  .hero-actions {
    margin-top: 1.6rem;
    margin-bottom: 0;
  }

  /* Proof of the product, as a line of type rather than another boxed panel —
     the hero should state the claim, not restate the dashboard. */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    margin: 1.75rem 0 0;
    color: var(--ink-3);
    font-size: 0.92rem;
  }
  .hero-facts strong {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .hero-facts span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .hero-facts span + span {
    position: relative;
  }
  @media (min-width: 34rem) {
    .hero-facts span + span::before {
      content: "";
      position: absolute;
      left: -0.78rem;
      top: 0.42em;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--rule-strong);
    }
  }

  .national-body {
    padding-bottom: 2.5rem;
  }
  .section {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  /* Countdown, stats and entry cards form one Victoria block: even spacing
     between them, so the section reads as a unit rather than three panels. */
  .national-body :global(.countdown) {
    margin-bottom: 1.1rem;
  }
  .entry-grid {
    margin-top: 1.1rem;
  }
  .poll-pair {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.1rem;
  }
  @media (min-width: 64rem) {
    .poll-pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .upcoming-date {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 640;
    color: var(--ink);
  }
  .upcoming-card .muted {
    margin: 0.2rem 0 0;
  }
</style>
