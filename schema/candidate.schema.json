{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electiontracker.au/schema/candidate.schema.json",
  "title": "Candidacy record",
  "type": "object",
  "required": ["candidate"],
  "properties": {
    "candidate": {
      "type": "object",
      "required": ["name", "party", "contest", "chamber", "status", "history"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "party": { "type": "string", "description": "slug from parties.yaml" },
        "contest": { "type": "string", "description": "district or region slug" },
        "chamber": { "enum": ["assembly", "council"] },
        "status": {
          "enum": ["announced", "endorsed", "nominated", "withdrawn", "disendorsed", "elected", "defeated"]
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["status", "date", "source"],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": ["announced", "endorsed", "nominated", "withdrawn", "disendorsed", "elected", "defeated"]
              },
              "date": { "type": "string", "format": "date" },
              "note": { "type": "string" },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "was", "now", "reason"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "was": { "type": "string" },
              "now": { "type": "string" },
              "reason": { "type": "string" },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "kind": { "type": "string" }
            }
          }
        },
        "occupation": {
          "type": "string",
          "description": "Optional short public occupation (e.g. lawyer, publican). Only when already public in a campaign/political context."
        },
        "background": {
          "type": "string",
          "description": "Optional one-line public background note. Not family, sex, or private life."
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "publisher", "accessed"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "published": { "type": "string", "format": "date" },
        "accessed": { "type": "string", "format": "date" },
        "archive_url": { "type": "string", "format": "uri" }
      }
    }
  }
}
