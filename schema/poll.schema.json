{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electiontracker.au/schema/poll.schema.json",
  "title": "Statewide voting-intention poll",
  "description": "Poll ledger record. Runtime validation is in scripts/validate.mjs; this schema documents the shape. See docs/POLL-METHODOLOGY.md.",
  "type": "object",
  "required": [
    "id",
    "pollster",
    "commissioner",
    "commissioner_type",
    "fieldwork_start",
    "fieldwork_end",
    "sample_size",
    "mode",
    "population",
    "primaries",
    "undecided_handling",
    "eligible_for_average",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable slug, e.g. resolve-2026-07-age"
    },
    "pollster": {
      "type": "string",
      "minLength": 1,
      "description": "Allowlist slug from docs/POLL-METHODOLOGY.md"
    },
    "commissioner": {
      "type": "string",
      "minLength": 1,
      "description": "Who paid or published the commission, e.g. the-age or self"
    },
    "commissioner_type": {
      "enum": [
        "media",
        "self",
        "academic",
        "excluded_advocacy",
        "party",
        "union",
        "candidate"
      ]
    },
    "fieldwork_start": { "type": "string", "format": "date" },
    "fieldwork_end": { "type": "string", "format": "date" },
    "sample_size": { "type": "integer", "minimum": 1 },
    "design_effect": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "null → implementation default 1.3"
    },
    "mode": {
      "enum": ["online", "sms", "phone", "mixed", "other"]
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "question_notes": { "type": "string" },
    "primaries": {
      "type": "object",
      "required": ["alp", "lnp", "grn", "onp", "others"],
      "additionalProperties": false,
      "properties": {
        "alp": { "type": "number", "minimum": 0, "maximum": 100 },
        "lnp": { "type": "number", "minimum": 0, "maximum": 100 },
        "grn": { "type": "number", "minimum": 0, "maximum": 100 },
        "onp": { "type": "number", "minimum": 0, "maximum": 100 },
        "others": { "type": "number", "minimum": 0, "maximum": 100 },
        "liberal": { "type": "number", "minimum": 0, "maximum": 100 },
        "nationals": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "undecided_handling": {
      "enum": ["allocated", "excluded", "not-stated"]
    },
    "eligible_for_average": { "type": "boolean" },
    "exclusion_reason": {
      "type": ["string", "null"],
      "description": "Required when eligible_for_average is false"
    },
    "eligibility_exception": {
      "type": ["string", "null"],
      "description": "Required when eligible_for_average is true despite party/union/advocacy/excluded_advocacy commissioner_type. Documents the case-by-case exception under POLL-METHODOLOGY.md."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "publisher", "accessed"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "published": { "type": "string", "format": "date" },
        "accessed": { "type": "string", "format": "date" },
        "archive_url": { "type": "string", "format": "uri" }
      }
    }
  }
}
