{
  // Assets-only Worker: no server code, no compute, no bindings.
  //
  // There is deliberately no "main" entry point. Cloudflare serves the built
  // files straight from its edge, exactly as Pages did — this is static
  // hosting on the Workers platform, not a server. See docs/DECISIONS.md ADR-2:
  // no D1, no R2, no KV, no request-time logic.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elections",
  "compatibility_date": "2026-07-28",

  // The site is served from electiontracker.au (custom domain). Turning the
  // workers.dev hostname off stops it answering on a second public hostname
  // with byte-identical content. Only safe because the custom domain resolves;
  // if it ever breaks, flip this back to reach the site again.
  "workers_dev": false,
  // Per-branch preview URLs, kept for reviewing data changes before merge.
  // These live on the workers.dev subdomain, so if disabling workers_dev also
  // kills previews, that is the trade-off — re-enable workers_dev if previews
  // matter more than the duplicate hostname.
  "preview_urls": true,
  "assets": {
    // Astro's output. Produced by `npm run build`, which validates the data
    // and regenerates the JSON/CSV exports first.
    "directory": "./site/dist",
    // Serve our own 404 page for unmatched paths rather than a bare error.
    "not_found_handling": "404-page",
    // One canonical URL shape: no trailing slash. Must stay in step with
    // `trailingSlash: "never"` in site/astro.config.mjs, which is what the
    // sitemap and the <link rel=canonical> tags follow. If these disagree,
    // the canonical tag points at a URL that redirects somewhere else.
    "html_handling": "drop-trailing-slash"
  }
}
